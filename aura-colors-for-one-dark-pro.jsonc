// ============================================================================
//  Aura Dracula Spirit (Soft) skin for One Dark Pro — with HDL Clarity Pack
// ----------------------------------------------------------------------------
//  Paste these top-level keys into the OTHER station's user settings.json
//  (Ctrl+Shift+P -> "Preferences: Open User Settings (JSON)").
//  If a key already exists there, merge the contents instead of duplicating it.
//
//  The "[*One Dark*]" scope matches any One Dark variant ("One Dark Pro",
//  "One Dark Pro Darker", "Atom One Dark", ...), so it works no matter which
//  flavor is selected — and it leaves every other theme untouched.
//
//  HDL CLARITY PACK (VHDL / Verilog / SystemVerilog):
//  Rules were derived by tracing the actual TextMate grammars of BOTH
//  installed HDL extensions (teros-technology.teroshdl 7.0.3 and
//  mshr-h.veriloghdl 1.29.0). Both register grammars for the same languages;
//  VS Code resolves this last-writer-wins (TerosHDL usually wins), so every
//  rule below targets the UNION of both grammars' scopes — the colors hold
//  no matter which grammar tokenizes the file.
//
//  Color roles (Aura palette + one new structural lavender):
//    #a277ff  purple        keywords (italic = modifiers/directions/qualifiers)
//    #82e2ff  light blue    types: builtins, user types, module/entity refs
//    #ffca85  orange        names being defined + callables (functions, $tasks,
//                           module/class/package names, instances, labels)
//    #61ffca  green         literals & constants (numbers, strings, ALL_CAPS
//                           params, enum members, VHDL constants)
//    #f694ff  pink          operators, preprocessor/macros, port formals,
//                           record members, attributes, escapes
//    #b39ddb  lavender      VHDL structural punctuation (parens, ; , := =>) —
//                           quiet so identifiers pop
//    #edecee  near-white    plain signals/variables (italic = declaration site)
//    #64548E  dim purple    comments (italic)
//    #ff6767  red           genuinely invalid code (mismatched end labels...)
// ============================================================================
{
  // -------- Workbench / UI colors (full Aura palette + your local tweaks) ----
  "workbench.colorCustomizations": {
    "[*One Dark*]": {
      // Editor
      "editor.background": "#191521",
      "editor.foreground": "#edecee",
      "editorLineNumber.foreground": "#a394f033",
      "editorCursor.foreground": "#a277ff",
      "editorCursor.background": "#000000",
      "editor.selectionBackground": "#3d375e7f",
      "editor.selectionHighlightBackground": "#3d375e7f",
      "editor.inactiveSelectionBackground": "#3d375e7f",
      "editor.wordHighlightBackground": "#3d375e7f",
      "editor.wordHighlightStrongBackground": "#3d375e7f",
      "editor.findMatchBackground": "#3d375e7f",
      "editor.findMatchHighlightBackground": "#3d375e7f",
      "editor.findRangeHighlightBackground": "#3d375e7f",
      "editor.lineHighlightBackground": "#a394f011",
      "editor.lineHighlightBorder": "#a394f000",
      "editor.stackFrameHighlightBackground": "#353424",
      "editorIndentGuide.background": "#2d2d2d",
      "editorIndentGuide.activeBackground": "#6d6d6d",
      "editorWhitespace.foreground": "#2d2d2d",
      "editorBracketMatch.border": "#a277ff",
      "editorLink.activeForeground": "#a277ff",
      "editorInlayHint.background": "#2e2b38",
      "editorInlayHint.foreground": "#cdccce",
      "editorError.foreground": "#ff6767",
      "editorError.border": "#ffffff00",
      "editorWarning.foreground": "#ffca85",
      "editorWarning.border": "#ffffff00",
      "editorGutter.modifiedBackground": "#ffca85",
      "editorGutter.addedBackground": "#61ffca",
      "editorGutter.deletedBackground": "#ff6767",

      // Widgets (find, suggest, hover)
      "editorWidget.background": "#100b15",
      "editorWidget.border": "#2d2d2d",
      "editorSuggestWidget.background": "#140e1a",
      "editorSuggestWidget.border": "#f694ff81",
      "editorSuggestWidget.foreground": "#cdccce",
      "editorSuggestWidget.highlightForeground": "#61ffca",
      "editorSuggestWidget.selectedBackground": "#3A334B",
      "editorHoverWidget.background": "#140e1a",
      "editorHoverWidget.border": "#f694ff81",

      // Tabs / editor groups
      "editorGroup.border": "#000000",
      "editorGroup.dropBackground": "#3d375e7f",
      "editorGroupHeader.tabsBackground": "#14111b",
      "editorGroupHeader.tabsBorder": "#000000",
      "tab.activeBackground": "#191521",
      "tab.activeForeground": "#a277ff",
      "tab.border": "#111111",
      "tab.inactiveBackground": "#191521",
      "tab.inactiveForeground": "#6d6d6d",
      "tab.activeBorderTop": "#a277ff",

      // Side bar / activity bar / panel / status bar / title bar
      "sideBar.background": "#191521",
      "sideBar.foreground": "#cdccce",
      "sideBar.border": "#000000",
      "sideBarTitle.foreground": "#adacae",
      "sideBarSectionHeader.background": "#191521",
      "sideBarSectionHeader.foreground": "#adacae",
      "activityBar.background": "#191521",
      "activityBar.foreground": "#a277ff",
      "activityBar.inactiveForeground": "#776882",
      "activityBar.border": "#000000",
      "activityBar.activeBorder": "#a277ff",
      "activityBarBadge.background": "#f694ff",
      "activityBarBadge.foreground": "#140E1A",
      "panel.border": "#f694ff81",
      "panelTitle.activeBorder": "#61ffca",
      "panelTitle.activeForeground": "#cdccce",
      "statusBar.background": "#14111b",
      "statusBar.foreground": "#adacae",
      "statusBar.border": "#000000",
      "statusBar.noFolderBackground": "#100b15",
      "statusBar.debuggingForeground": "#140E1A",
      "statusBar.debuggingBackground": "#a19c77",
      "statusBarItem.activeBackground": "#a277ff",
      "titleBar.activeBackground": "#14111b",
      "titleBar.inactiveBackground": "#2d2b38",
      "titleBar.border": "#000000",

      // Base / chrome
      "foreground": "#ffffff",
      "errorForeground": "#ff6767",
      "focusBorder": "#a394f033",
      "widget.shadow": "#0f0f0f",
      "selection.background": "#3d375e7f",
      "badge.background": "#a277ff",
      "badge.foreground": "#140E1A",
      "button.background": "#61ffca",
      "button.foreground": "#140E1A",
      "button.hoverBackground": "#49c29a",
      "dropdown.background": "#140E1A",
      "dropdown.border": "#3b334b",
      "dropdown.foreground": "#cdccce",
      "input.background": "#140E1A",
      "input.border": "#3b334b",
      "input.foreground": "#cdccce",
      "input.placeholderForeground": "#af8aff7f",
      "inputOption.activeBorder": "#a277ff",
      "progressBar.background": "#61ffca",
      "textLink.foreground": "#a277ff",
      "textLink.activeForeground": "#8F5BFF",

      // Lists & trees
      "list.activeSelectionBackground": "#2e2b38",
      "list.activeSelectionForeground": "#a277ff",
      "list.inactiveSelectionBackground": "#2e2b38",
      "list.inactiveSelectionForeground": "#a277ff",
      "list.focusBackground": "#3b334b",
      "list.focusForeground": "#a277ff",
      "list.hoverBackground": "#3b334b",
      "list.hoverForeground": "#edecee",
      "list.highlightForeground": "#ffca85",
      "list.errorForeground": "#ff6767",
      "list.warningForeground": "#ffca85",
      "tree.indentGuidesStroke": "#4d4d4d",

      // Scrollbar + overview ruler (ruler fully hidden, like your setup)
      "scrollbar.shadow": "#140E1A",
      "scrollbarSlider.background": "#a394f033",
      "scrollbarSlider.hoverBackground": "#a394f033",
      "scrollbarSlider.activeBackground": "#3d375e7f",
      "editorOverviewRuler.border": "#0000",
      "editorOverviewRuler.findMatchForeground": "#0000",
      "editorOverviewRuler.rangeHighlightForeground": "#0000",
      "editorOverviewRuler.selectionHighlightForeground": "#0000",
      "editorOverviewRuler.wordHighlightForeground": "#0000",
      "editorOverviewRuler.wordHighlightStrongForeground": "#0000",
      "editorOverviewRuler.bracketMatchForeground": "#0000",
      "editorOverviewRuler.modifiedForeground": "#0000",
      "editorOverviewRuler.addedForeground": "#0000",
      "editorOverviewRuler.deletedForeground": "#0000",
      "editorOverviewRuler.errorForeground": "#0000",
      "editorOverviewRuler.warningForeground": "#0000",
      "editorOverviewRuler.infoForeground": "#0000",

      // Terminal
      "terminal.background": "#191521",
      "terminal.foreground": "#cdccce",
      "terminal.selectionBackground": "#3d375e7f",
      "terminalCursor.background": "#2d2d2d",
      "terminalCursor.foreground": "#adacae",
      "terminal.ansiBlack": "#140E1A",
      "terminal.ansiRed": "#ff6767",
      "terminal.ansiGreen": "#8EFFD9",
      "terminal.ansiYellow": "#ffca85",
      "terminal.ansiBlue": "#F477FF",
      "terminal.ansiMagenta": "#61ffca",
      "terminal.ansiCyan": "#a277ff",
      "terminal.ansiWhite": "#cdccce",
      "terminal.ansiBrightBlack": "#2d2d2d",
      "terminal.ansiBrightRed": "#ffca85",
      "terminal.ansiBrightGreen": "#a277ff",
      "terminal.ansiBrightYellow": "#ffca85",
      "terminal.ansiBrightBlue": "#a277ff",
      "terminal.ansiBrightMagenta": "#61ffca",
      "terminal.ansiBrightCyan": "#61ffca",
      "terminal.ansiBrightWhite": "#edecee",

      // Git / diff / peek
      "gitDecoration.modifiedResourceForeground": "#ffca85",
      "gitDecoration.stageModifiedResourceForeground": "#ffca85",
      "gitDecoration.deletedResourceForeground": "#ff6767",
      "gitDecoration.untrackedResourceForeground": "#a277ff",
      "gitDecoration.ignoredResourceForeground": "#4d4d4d",
      "gitDecoration.conflictingResourceForeground": "#a277ff",
      "diffEditor.insertedTextBackground": "#00d89023",
      "diffEditor.removedTextBackground": "#ff474720",
      "peekView.border": "#14111b",
      "peekViewEditor.background": "#140e1a",
      "peekViewEditorGutter.background": "#140e1a",
      "peekViewResult.background": "#14111b",
      "peekViewTitle.background": "#14111b",
      "peekViewTitleDescription.foreground": "#FFF4E5",
      "peekViewTitleLabel.foreground": "#a277ff"
    }
  },

  // -------- Syntax colors ----------------------------------------------------
  "editor.tokenColorCustomizations": {
    "[*One Dark*]": {
      "textMateRules": [
        // ════════════════════════════════════════════════════════════════
        //  PART 1 — Aura Dracula Spirit (Soft) base rules (general languages)
        // ════════════════════════════════════════════════════════════════
        {
          "scope": [
            "support.type.property-name.css",
            "meta.property-name.scss",
            "source.css.scss"
          ],
          "settings": { "foreground": "#a277ff", "fontStyle": "italic" }
        },
        {
          "scope": [
            "keyword.operator.comparison",
            "keyword.control.loop.js",
            "keyword.control.loop.ts",
            "keyword.control.import.js",
            "keyword.control.import.ts",
            "keyword.control.import.tsx",
            "keyword.control.from.js",
            "keyword.control.from.ts",
            "keyword.control.from.tsx",
            "keyword.control.export",
            "keyword.operator.instanceof.js",
            "keyword.operator.expression.instanceof.ts",
            "keyword.operator.expression.instanceof.tsx"
          ],
          "settings": { "foreground": "#f694ff" }
        },
        {
          "scope": ["storage.modifier.async"],
          "settings": { "foreground": "#f694ff", "fontStyle": "italic" }
        },
        {
          "name": "Purple — keywords, storage, support, tags",
          "scope": [
            "keyword",
            "storage",
            "support",
            "entity.name.tag",
            "variable.language",
            "keyword.control.flow",
            "storage.modifier",
            "keyword.operator",
            "entity.other.attribute-name.class.css",
            "entity.other.keyframe-offset",
            "markup.heading",
            "markup.underline.link",
            "variable.other.env",
            "punctuation.definition.list.begin.markdown",
            "punctuation.definition.bold.markdown",
            "punctuation.definition.italic.markdown",
            "punctuation.definition.markdown",
            "punctuation.definition.quote.begin.markdown",
            "punctuation.definition.raw.markdown",
            "constant.length.units.css",
            "constant.percentage.units.css"
          ],
          "settings": { "foreground": "#a277ff" }
        },
        {
          "name": "Green — strings & constants",
          "scope": [
            "string",
            "markup.inserted",
            "markup.raw",
            "constant",
            "source.env",
            "support.type.builtin.graphql",
            "variable.other.quoted.double",
            "markup.inline.raw.string.markdown",
            "entity.other.attribute-name.id.css",
            "meta.jsx.children",
            "JSXNested"
          ],
          "settings": { "foreground": "#61ffca" }
        },
        {
          "name": "Orange — functions & components",
          "scope": [
            "markup.changed",
            "entity",
            "entity.name.function",
            "support.function",
            "entity.name.function.elixir",
            "entity.name.function-call.elixir",
            "support.class.component",
            "support.class.component.open",
            "support.class.component.close",
            "meta.function-call.generic.python",
            "entity.name.section.markdown",
            "storage.type.annotation.dart"
          ],
          "settings": { "foreground": "#ffca85" }
        },
        {
          "name": "Red — invalid / deleted",
          "scope": ["invalid", "markup.deleted"],
          "settings": { "foreground": "#ff6767" }
        },
        {
          "name": "Pink — properties, attributes, separators",
          "scope": [
            "string.unquoted",
            "punctuation.separator",
            "entity.other.attribute-name",
            "meta.object-literal.key",
            "variable.object.property",
            "variable.other.property",
            "variable.other.object.property",
            "variable.other.constant.property",
            "meta.type.annotation",
            "support.type.vendored",
            "constant.language.symbol.elixir",
            "variable.graphql",
            "meta.attribute.python",
            "source.dart"
          ],
          "settings": { "foreground": "#f694ff" }
        },
        {
          "name": "Foreground — variables, params, punctuation",
          "scope": [
            "variable",
            "markup.list",
            "support.constant.property-value.css",
            "variable.parameter.keyframe-list.css",
            "source.css",
            "support.constant.font-name",
            "support.constant.vendored.property-value",
            "variable.parameter",
            "meta.class",
            "meta.method.declaration",
            "parameter.variable.function.elixir",
            "punctuation.definition.tag",
            "punctuation.section.embedded",
            "meta.embedded.expression",
            "punctuation.terminator.dart",
            "punctuation.dot.dart"
          ],
          "settings": { "foreground": "#edecee" }
        },
        {
          "name": "Comments (italic to match your setup)",
          "scope": ["comment"],
          "settings": { "foreground": "#64548E", "fontStyle": "italic" }
        },
        {
          "scope": ["string.quoted.docstring.multi.python"],
          "settings": { "foreground": "#64548E" }
        },
        {
          "name": "Light blue — types & classes",
          "scope": [
            "entity.name.type",
            "entity.name.class",
            "support.class.builtin",
            "punctuation.definition.template-expression.begin",
            "punctuation.definition.template-expression.end",
            "punctuation.quasi.element.begin",
            "punctuation.quasi.element.end",
            "entity.other.inherited-class",
            "variable.other.constant.elixir",
            "support.class.dart"
          ],
          "settings": { "foreground": "#82e2ff" }
        },
        {
          "name": "Italics",
          "scope": [
            "meta.return.type",
            "entity.name.type.interface",
            "meta.type.annotation",
            "meta.function.parameters",
            "markup.italic.markdown"
          ],
          "settings": { "fontStyle": "italic" }
        },
        {
          "scope": "markup.underline",
          "settings": { "fontStyle": "underline" }
        },
        {
          "scope": ["markup.bold.markdown", "storage.type.annotation.dart"],
          "settings": { "fontStyle": "bold" }
        },

        // ════════════════════════════════════════════════════════════════
        //  PART 2 — One Dark Pro neutralizers
        //  ODP defines deeper scopes than Aura, and deeper scopes win.
        //  These pin them back to Aura colors for non-HDL languages.
        // ════════════════════════════════════════════════════════════════
        {
          "name": "ODP fix — numbers/constants back to green",
          "scope": [
            "constant.numeric",
            "constant.language",
            "constant.character",
            "constant.other"
          ],
          "settings": { "foreground": "#61ffca" }
        },
        {
          "name": "ODP fix — all string flavors green",
          "scope": ["string.quoted", "string.template", "string.regexp"],
          "settings": { "foreground": "#61ffca" }
        },
        {
          "name": "ODP fix — string quotes match string body",
          "scope": ["punctuation.definition.string"],
          "settings": { "foreground": "#61ffca" }
        },
        {
          "name": "ODP fix — keywords/storage back to purple",
          "scope": [
            "keyword.control",
            "storage.type",
            "support.type",
            "support.constant",
            "support.variable",
            "support.class",
            "keyword.operator.assignment",
            "keyword.operator.arithmetic",
            "keyword.operator.logical",
            "keyword.operator.ternary"
          ],
          "settings": { "foreground": "#a277ff" }
        },
        {
          "name": "ODP fix — comment slashes match comment body",
          "scope": ["punctuation.definition.comment"],
          "settings": { "foreground": "#64548E", "fontStyle": "italic" }
        },
        {
          "name": "ODP fix — plain variables stay near-white",
          "scope": [
            "variable.other.readwrite",
            "variable.other.object",
            "variable.parameter.function"
          ],
          "settings": { "foreground": "#edecee" }
        },
        {
          "name": "ODP fix — classes stay light blue",
          "scope": ["entity.name.type.class"],
          "settings": { "foreground": "#82e2ff" }
        },
        {
          "name": "ODP fix — invalid code red (ODP paints invalid.illegal white)",
          "scope": [
            "invalid.illegal",
            "invalid.broken",
            "invalid.unimplemented",
            "invalid.deprecated"
          ],
          "settings": { "foreground": "#ff6767" }
        },
        {
          "name": "ODP fix — JSON/TOML keys back to purple (ODP's deeper rules win otherwise)",
          "scope": [
            "support.type.property-name.json",
            "support.type.property-name.toml",
            "support.type.property-name.table.toml",
            "support.type.property-name.array.toml"
          ],
          "settings": { "foreground": "#a277ff" }
        },
        {
          "name": "ODP fix — docstring quotes match dim docstring body",
          "scope": [
            "string.quoted.docstring.multi.python punctuation.definition.string"
          ],
          "settings": { "foreground": "#64548E" }
        },

        // ════════════════════════════════════════════════════════════════
        //  PART 3 — HDL CLARITY PACK  (VHDL / Verilog / SystemVerilog)
        //  Scopes traced from teros-technology.teroshdl 7.0.3 and
        //  mshr-h.veriloghdl 1.29.0 grammars. Deeper selectors beat the
        //  generic Aura/neutralizer rules above, so HDL gets its own look.
        //  Note: neither extension emits LSP semantic tokens (verified), so
        //  TextMate scopes are the only color source for HDL.
        // ════════════════════════════════════════════════════════════════

        // ---- Keywords: modifiers/directions/qualifiers -> italic purple ----
        // posedge/negedge/parameter/localparam/generate/virtual (keyword.other),
        // input/output/inout + pkg:: qualifiers (support.type.*), packed/
        // unsigned (storage.modifier.*), rand/randc (storage.type.rand)
        {
          "name": "HDL — modifier keywords italic purple",
          "scope": [
            "keyword.other.systemverilog",
            "storage.modifier.systemverilog",
            "storage.modifier.verilog",
            "storage.type.rand.systemverilog",
            "storage.type.rand.verilog",
            "support.type.systemverilog",
            "support.type.verilog",
            "support.type.scope.systemverilog",
            "support.type.scope.verilog",
            "support.type.direction.systemverilog"
          ],
          "settings": { "foreground": "#a277ff", "fontStyle": "italic" }
        },
        // mshr-h's Verilog grammar lumps ALL keywords into keyword.other.verilog
        // (and 'module' into storage.type.module.verilog; 'class'/'function'
        // keywords into storage.type.class/.function in its SV grammar) —
        // keep those plain purple, not italic.
        {
          "name": "HDL — plain keywords purple",
          "scope": [
            "keyword.other.verilog",
            "keyword.other.block.systemverilog",
            "keyword.other.block.verilog",
            "storage.type.class.systemverilog",
            "storage.type.function.systemverilog",
            "storage.type.module.verilog",
            "keyword.sva.systemverilog",
            "keyword.sva.verilog",
            "keyword.psl.systemverilog",
            "keyword.psl.verilog",
            "keyword.cover.systemverilog",
            "keyword.cover.verilog"
          ],
          "settings": { "foreground": "#a277ff" }
        },

        // ---- Types -> light blue -------------------------------------------
        // Builtin types (logic/bit/int/wire/reg...), user-defined types at use
        // sites, module/interface types at instantiation, VHDL std/ieee types.
        // (VHDL entity.name.type.* — entity/arch/type/package decl names and
        //  ':' subtype indications — is already light blue via the Aura
        //  "entity.name.type" rule in Part 1.)
        // meta.typedef.* paints the otherwise-unscoped SOURCE type in
        // "typedef custom_type new_type_name;" light blue in both grammars.
        {
          "name": "HDL — types light blue",
          "scope": [
            "storage.type.systemverilog",
            "storage.type.verilog",
            "storage.type.userdefined.systemverilog",
            "storage.type.userdefined.verilog",
            "storage.type.user-defined.systemverilog",
            "storage.type.vector.systemverilog",
            "storage.type.atom.systemverilog",
            "storage.type.built-in.systemverilog",
            "storage.type.notint.systemverilog",
            "storage.type.interface.systemverilog",
            "storage.type.interface.verilog",
            "storage.module.systemverilog",
            "storage.module.verilog",
            "meta.typedef.systemverilog",
            "meta.typedef.simple.systemverilog",
            "meta.typedef.simple.verilog",
            "entity.name.tag.module.reference.verilog",
            "entity.name.tag.entity.reference.vhdl",
            "entity.name.tag.component.reference.vhdl",
            "entity.name.tag.architecture.reference.vhdl",
            "entity.name.section.package.begin.vhdl",
            "entity.name.section.package.end.vhdl",
            "entity.name.section.package_body.begin.vhdl",
            "entity.name.section.package_body.end.vhdl",
            "support.type.ieee.std_logic_1164.vhdl",
            "support.type.ieee.numeric_std.vhdl",
            "support.type.ieee.math_complex.vhdl",
            "support.type.std.standard.vhdl",
            "support.type.std.textio.vhdl"
          ],
          "settings": { "foreground": "#82e2ff" }
        },
        {
          "name": "HDL — UVM base classes + inherited classes italic blue",
          "scope": [
            "storage.type.uvm.systemverilog",
            "storage.type.uvm.verilog",
            "entity.other.inherited-class"
          ],
          "settings": { "foreground": "#82e2ff", "fontStyle": "italic" }
        },
        // mshr-h lumps wire/tri AND 'parameter'-inside-#() into
        // storage.type.net — italic blue gives nets/params a style cue so
        // 'parameter int' doesn't read as two identical blue words.
        {
          "name": "HDL — net types italic blue (mshr-h)",
          "scope": ["storage.type.net.systemverilog"],
          "settings": { "foreground": "#82e2ff", "fontStyle": "italic" }
        },

        // ---- Definition names & callables -> orange ------------------------
        // Module/class/package/interface names, instance names, function/task
        // call sites, block/process/generate labels. Declared function names
        // and $system tasks and VHDL stdlib calls (rising_edge...) are already
        // orange via "entity.name.function" / "support.function" in Part 1.
        {
          "name": "HDL — definition names, instances, labels orange",
          "scope": [
            "entity.name.type.module.systemverilog",
            "entity.name.type.module.verilog",
            "entity.name.type.class.systemverilog",
            "entity.name.type.class.verilog",
            "entity.name.declaration.systemverilog",
            "entity.name.declaration.verilog",
            "variable.other.module.systemverilog",
            "entity.name.tag.module.identifier.verilog",
            "support.function.generic.systemverilog",
            "support.function.generic.verilog",
            "entity.name.tag.vhdl",
            "entity.name.tag.for.generate.begin.vhdl",
            "entity.name.tag.for.generate.end.vhdl",
            "entity.name.tag.if.generate.begin.vhdl",
            "entity.name.tag.if.generate.end.vhdl",
            "entity.name.tag.case.begin.vhdl",
            "entity.name.tag.case.end.vhdl",
            "entity.name.tag.while.loop.vhdl",
            "entity.name.section.entity_instantiation.vhdl",
            "entity.name.section.component_instantiation.vhdl",
            "entity.name.section.process.begin.vhdl",
            "entity.name.section.process.end.vhdl",
            "entity.name.section.systemverilog",
            "entity.name.section.verilog",
            "entity.name.goto-label.php"
          ],
          "settings": { "foreground": "#ffca85" }
        },

        // ---- Constants -> green --------------------------------------------
        // Numbers, ALL_CAPS params/enum members (constant.other.net) and
        // strings are already green via Part 1/2. These pin the rest:
        // VHDL constant decl names, 'when' choices, true/false/ns/failure...
        {
          "name": "HDL — constants green",
          "scope": [
            "entity.name.constant.vhdl",
            "support.constant.vhdl",
            "support.constant.std_standard.vhdl",
            "support.constant.std_textio.vhdl",
            "support.constant.ieee_math_real.vhdl",
            "support.constant.ieee_math_complex.vhdl",
            "support.constant.ieee_fixed_pkg.vhdl",
            "support.constant.ieee_float_pkg.vhdl",
            "support.constant.std.standard.vhdl",
            "support.constant.ieee.math_real.vhdl",
            "support.constant.ieee.math_complex.vhdl",
            "support.constant.systemverilog",
            "support.constant.verilog"
          ],
          "settings": { "foreground": "#61ffca" }
        },

        // ---- Preprocessor & macros -> pink ---------------------------------
        // `define/`include/`ifdef directives, macro names and `USAGE — in both
        // grammars' (very different) scope spellings.
        {
          "name": "HDL — preprocessor & macros pink",
          "scope": [
            "constant.other.define.systemverilog",
            "constant.other.define.verilog",
            "constant.other.preprocessor.systemverilog",
            "constant.other.preprocessor.verilog",
            "entity.name.type.define.systemverilog",
            "entity.name.type.define.verilog",
            "support.variable.systemverilog",
            "support.variable.verilog",
            "string.regexp.systemverilog",
            "string.regexp.identifier.systemverilog",
            "variable.other.constant.preprocessor.systemverilog",
            "punctuation.definition.directive.systemverilog",
            "keyword.other.compiler.directive.verilog",
            "variable.other.constant.verilog"
          ],
          "settings": { "foreground": "#f694ff" }
        },

        // ---- Named-association formals & members -> pink -------------------
        // .clk(...) port names in SV instantiations, formal names in VHDL
        // port/generic maps, record members.
        {
          "name": "HDL — port formals & record members pink",
          "scope": [
            "support.function.port.systemverilog",
            "support.function.port.verilog",
            "variable.parameter.vhdl",
            "variable.other.member.vhdl"
          ],
          "settings": { "foreground": "#f694ff", "fontStyle": "" }
        },
        {
          "name": "HDL — modports & attributes italic pink",
          "scope": [
            "support.modport.systemverilog",
            "support.modport.verilog",
            "variable.annotation.vhdl",
            "keyword.attributes.vhdl"
          ],
          "settings": { "foreground": "#f694ff", "fontStyle": "italic" }
        },

        // ---- Operators (SV/V) -> pink --------------------------------------
        {
          "name": "HDL — SV/Verilog operators pink",
          "scope": [
            "keyword.operator.systemverilog",
            "keyword.operator.verilog",
            "keyword.operator.arithmetic.systemverilog",
            "keyword.operator.arithmetic.verilog",
            "keyword.operator.assignment.systemverilog",
            "keyword.operator.bitwise.systemverilog",
            "keyword.operator.bitwise.verilog",
            "keyword.operator.bitwise.shift.systemverilog",
            "keyword.operator.cast.systemverilog",
            "keyword.operator.cast.verilog",
            "keyword.operator.channel.systemverilog",
            "keyword.operator.comparison.systemverilog",
            "keyword.operator.comparison.verilog",
            "keyword.operator.decrement.systemverilog",
            "keyword.operator.increment.systemverilog",
            "keyword.operator.logical.systemverilog",
            "keyword.operator.logical.verilog",
            "keyword.operator.other.systemverilog",
            "keyword.operator.other.verilog",
            "keyword.operator.param.systemverilog",
            "keyword.operator.param.verilog",
            "keyword.operator.scope.systemverilog",
            "keyword.operator.scope.verilog",
            "source.systemverilog keyword.operator.quantifier.regexp",
            "source.verilog keyword.operator.quantifier.regexp"
          ],
          "settings": { "foreground": "#f694ff" }
        },

        // ---- VHDL structural punctuation -> quiet lavender -----------------
        // TerosHDL scopes EVERY paren/comma/semicolon/:=/=> as
        // keyword.operator.vhdl (one use-clause ';' as bare keyword.operator);
        // mshr-h uses punctuation.vhdl. Muted so identifiers and literals
        // carry the color weight. #b39ddb keeps clear separation from keyword
        // purple #a277ff under color-vision deficiencies.
        {
          "name": "VHDL — structural punctuation lavender",
          "scope": [
            "keyword.operator.vhdl",
            "source.vhdl keyword.operator",
            "punctuation.vhdl",
            "meta.item.stopping.character.vhdl",
            "punctual.vhdl",
            "punctuation.terminator.function_prototype.vhdl"
          ],
          "settings": { "foreground": "#b39ddb" }
        },
        // 'end fifo;' echoes and 'end : label' echoes — de-emphasized
        {
          "name": "HDL — end-label echoes italic lavender",
          "scope": [
            "entity.name.endlabel.type.vhdl",
            "entity.label.systemverilog",
            "entity.label.verilog"
          ],
          "settings": { "foreground": "#b39ddb", "fontStyle": "italic" }
        },

        // ---- Declaration-site names (VHDL) -> italic near-white ------------
        // Declared signal/variable names, library names (ieee, work).
        {
          "name": "VHDL — declared signals & library names italic white",
          "scope": [
            "entity.name.variable.vhdl",
            "entity.name.section.vhdl",
            "entity.name.tag.library.reference.vhdl"
          ],
          "settings": { "foreground": "#edecee", "fontStyle": "italic" }
        },

        // ---- Plain identifiers -> near-white -------------------------------
        {
          "name": "HDL — plain identifiers near-white",
          "scope": [
            "variable.other.identifier.systemverilog",
            "variable.other.identifier.verilog"
          ],
          "settings": { "foreground": "#edecee" }
        },

        // ---- String escapes & format placeholders (HDL only) -> pink -------
        {
          "name": "HDL — escapes & format placeholders pink",
          "scope": [
            "constant.character.escape.systemverilog",
            "constant.character.escape.verilog",
            "constant.character.escape.vhdl",
            "constant.other.placeholder.systemverilog",
            "constant.other.placeholder.verilog",
            "constant.character.format.placeholder.systemverilog"
          ],
          "settings": { "foreground": "#f694ff" }
        },

        // ---- TODO/FIXME markers inside HDL comments -> bold orange ---------
        // (grammar-level highlight; not an actual error, so not red)
        {
          "name": "HDL — comment TODO/FIXME markers",
          "scope": [
            "invalid.illegal.comment-highlight.vhdl",
            "invalid.unimplemented.todo.systemverilog",
            "invalid.broken.fixme.systemverilog"
          ],
          "settings": { "foreground": "#ffca85", "fontStyle": "bold italic" }
        },

        // ---- Punctuation polish --------------------------------------------
        // Statement terminators / param-list parens back to near-white
        {
          "name": "HDL — terminators & param parens near-white",
          "scope": [
            "punctuation.section.parameters.begin",
            "punctuation.section.parameters.end",
            "punctuation.definition.typedef.end.systemverilog",
            "punctuation.definition.module.end.systemverilog",
            "punctuation.definition.class.end.systemverilog",
            "punctuation.definition.function.end.systemverilog",
            "punctuation.module.instantiation.end.systemverilog",
            "punctuation.definition.label.systemverilog",
            "punctuation.section.list.verilog",
            "punctuation.terminator.expression.verilog"
          ],
          "settings": { "foreground": "#edecee" }
        },
        // Bit-range brackets [7:0] pink to match their ':' operator
        {
          "name": "HDL — range brackets pink",
          "scope": [
            "punctuation.slice.brackets.begin",
            "punctuation.slice.brackets.end",
            "punctuation.separator.range.verilog"
          ],
          "settings": { "foreground": "#f694ff" }
        }
      ]
    }
  },

  // -------- Semantic highlighting -------------------------------------------
  // Verified 2026-07: NO extension on either station emits LSP semantic tokens
  // for HDL today — TerosHDL's bundled vhdl_ls 0.84.0 does not advertise
  // semanticTokensProvider, TerosHDL's SV support is ctags-based (no LS), and
  // mshr-h ships no language server (all its languageServer.*.enabled flags
  // default to false). ALL HDL coloring therefore comes from the textMateRules
  // above. This section stays OFF globally (keeps the Aura look exact) but ON
  // for HDL files, so that if you ever enable an external LS that does emit
  // semantic tokens (verible-verilog-ls, veridian, svls...), its tokens get
  // repainted in the same palette instead of ODP defaults.
  "editor.semanticHighlighting.enabled": false,
  "[systemverilog]": { "editor.semanticHighlighting.enabled": true },
  "[verilog]": { "editor.semanticHighlighting.enabled": true },
  "[vhdl]": { "editor.semanticHighlighting.enabled": true },

  "editor.semanticTokenColorCustomizations": {
    "[*One Dark*]": {
      "rules": {
        // Purple — keywords & modifiers
        "keyword": "#a277ff",
        "modifier": { "foreground": "#a277ff", "fontStyle": "italic" },

        // Pink — operators, macros, members, events (matches TextMate pack)
        "operator": "#f694ff",
        "macro": "#f694ff",
        "property": "#f694ff",
        "event": "#f694ff",

        // Green — literals & constant-like things
        "string": "#61ffca",
        "number": "#61ffca",
        "regexp": "#61ffca",
        "enumMember": "#61ffca",
        "variable.readonly": "#61ffca",

        // Orange — callables
        "function": "#ffca85",
        "method": "#ffca85",
        "decorator": "#ffca85",

        // Light blue — types: modules, entities, packages, classes,
        // interfaces, typedefs, records
        "class": "#82e2ff",
        "struct": "#82e2ff",
        "enum": "#82e2ff",
        "interface": "#82e2ff",
        "type": "#82e2ff",
        "typeParameter": "#82e2ff",
        "namespace": "#82e2ff",

        // Near-white — plain signals, nets, variables, ports, block labels
        "variable": "#edecee",
        "parameter": "#edecee",
        "label": "#edecee",

        // Comments
        "comment": { "foreground": "#64548E", "fontStyle": "italic" }
      }
    }
  }
}
