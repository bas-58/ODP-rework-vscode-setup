{% extends "base.html" %}

{% block styles %}
{{ super() }}
<style>
  .md-header { display: none; }
  .md-tabs { height: auto; overflow: visible; background: none; }
  .md-tabs__inner { display: none; }
  .md-container { padding-top: 0; }
  .md-main { display: none; }
</style>
{% endblock %}

{% block tabs %}
<div class="ingot-landing">

  <!-- ============================================================ -->
  <section class="ingot-hero">
    <canvas id="ingot-traces" aria-hidden="true"></canvas>
    <div class="ingot-hero__gradient" aria-hidden="true"></div>

    <div class="ingot-container ingot-hero__content">
      <a class="ingot-lockup" href="{{ 'start/first-block/' | url }}">
        <img src="{{ 'assets/logo.svg' | url }}" alt="">
        <span>Ingot</span>
      </a>

      <h1 class="ingot-hero__headline">
        One command from source<br>to reproducible simulation.
      </h1>

      <p class="ingot-hero__lede">
        Ingot wraps VCS in a CLI that manages compiled libraries, shares
        analysis across build profiles, and prints the exact command to
        reproduce any failure. Convention over configuration, incremental
        by default.
      </p>

      <div class="ingot-hero__actions">
        <a href="{{ 'start/first-block/' | url }}" class="ingot-btn ingot-btn--primary">
          Get started
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="{{ 'concepts/philosophy/' | url }}" class="ingot-btn ingot-btn--ghost">
          Why Ingot
        </a>
      </div>
    </div>

    <div class="ingot-hero__scroll" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
    </div>
  </section>

  <!-- ============================================================ -->
  <section class="ingot-section ingot-section--features" data-reveal>
    <div class="ingot-container">
      <p class="ingot-eyebrow">What it does</p>
      <h2 class="ingot-section__title">The parts of the flow that were always manual.</h2>

      <div class="ingot-grid">

        <article class="ingot-card">
          <div class="ingot-card__icon">
            <svg viewBox="0 0 24 24"><path d="M12 2 2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <h3>Build profiles</h3>
          <p>Fast for regressions, debug for Verdi, coverage for closure.
             Switching costs one elaboration — analysis is shared.</p>
          <a href="{{ 'concepts/profiles/' | url }}">How profiles work</a>
        </article>

        <article class="ingot-card">
          <div class="ingot-card__icon">
            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
          </div>
          <h3>Per-unit libraries</h3>
          <p>Every block and library compiles once into its own VCS
             library. Change one unit; only that unit re-analyzes.</p>
          <a href="{{ 'concepts/units-and-libraries/' | url }}">The methodology</a>
        </article>

        <article class="ingot-card">
          <div class="ingot-card__icon">
            <svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>
          </div>
          <h3>Reproducible failures</h3>
          <p>Every run records its seed. Every failure prints the command
             to reproduce it, and the one to open it in a debugger.</p>
          <a href="{{ 'guides/debug-a-failure/' | url }}">Debug a failure</a>
        </article>

        <article class="ingot-card">
          <div class="ingot-card__icon">
            <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h10M4 18h6"/></svg>
          </div>
          <h3>Convention over configuration</h3>
          <p>A block is four lines of TOML. Sources are discovered, order
             is derived, include paths are found. Override only what differs.</p>
          <a href="{{ 'reference/manifest/' | url }}">Manifest reference</a>
        </article>

      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <section class="ingot-section ingot-section--terminal" data-reveal>
    <div class="ingot-container ingot-split">
      <div class="ingot-split__text">
        <p class="ingot-eyebrow">The loop</p>
        <h2 class="ingot-section__title">Three commands. One binary. Zero re-analysis.</h2>
        <p>Build once. Simulate as many times as you like against the same
           artifact. When something fails, switch to the debug profile —
           the analysis is already done, so you pay for one elaboration
           and nothing else.</p>
        <a href="{{ 'guides/build-and-simulate/' | url }}" class="ingot-link">Build and simulate</a>
      </div>

      <div class="ingot-terminal">
        <div class="ingot-terminal__bar">
          <span></span><span></span><span></span>
          <em>bash</em>
        </div>
<pre class="ingot-terminal__body"><span class="p">$</span> ingot build exemplar
  vlogan analyze    <span class="t">2.10s</span>  ok
  vcs elaborate    <span class="t">41.30s</span>  ok
<span class="ok">exemplar [fast]: build/exemplar/fast/simv</span>

<span class="p">$</span> ingot sim exemplar -t smoke
<span class="ok">PASS</span>  exemplar/smoke  seed=1847362  4.2s

<span class="p">$</span> ingot sim exemplar -t smoke -s 1847362 -p debug --waves
  vcs elaborate    <span class="t">58.02s</span>  ok   <span class="c">← analysis reused</span>
<span class="ok">PASS</span>  exemplar/smoke  seed=1847362  6.1s</pre>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <section class="ingot-section ingot-section--stats" data-reveal>
    <div class="ingot-container ingot-stats">
      <div class="ingot-stat">
        <strong>1×</strong>
        <span>analysis per unit, shared by every consumer</span>
      </div>
      <div class="ingot-stat">
        <strong>4 lines</strong>
        <span>of TOML to define a block</span>
      </div>
      <div class="ingot-stat">
        <strong>100%</strong>
        <span>of failures print a reproduce command</span>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <section class="ingot-section ingot-section--cta" data-reveal>
    <div class="ingot-container ingot-cta">
      <h2>Start with your first block.</h2>
      <p>Ten minutes from clone to a passing regression.</p>
      <a href="{{ 'start/first-block/' | url }}" class="ingot-btn ingot-btn--primary">
