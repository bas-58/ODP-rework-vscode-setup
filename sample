"""List build profiles."""

from __future__ import annotations

from typing import Annotated

import typer

from ingot.commands._common import fail
from ingot.manifest.profiles import list_profiles
from ingot.manifest.resolve import project_root, resolve_block
from ingot.manifest.schema import ManifestError

app = typer.Typer(help="Build profiles.")


@app.callback(invoke_without_command=True)
def profiles_command(
    block: Annotated[str | None, typer.Option("--block", "-b", help="Include a block's overrides.")] = None,
) -> None:
    """List build profiles and what each is for."""
    try:
        root = project_root()
        block_root = resolve_block(block, root).unit.root if block else None
        resolved = list_profiles(root, block_root)
    except ManifestError as error:
        raise fail(str(error)) from error

    for p in resolved:
        typer.secho(p.name, bold=True)
        if p.description:
            typer.echo(f"  {p.description}")
        if p.elab_args:
            typer.echo(f"  elab:      {' '.join(p.elab_args)}")
        if p.defines:
            typer.echo(f"  defines:   {', '.join(f'{k}={v}' if v else k for k, v in p.defines.items())}")
        if p.coverage:
            typer.echo(f"  coverage:  {p.coverage_metrics}  scope={p.coverage_scope}")
        typer.echo("")
