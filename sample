The dot grid on the hero background is the substrate the traces route across — same 24px pitch as GRID. The first section's negative margin, rounded top, and upward shadow make it read as a card sliding up over the hero.

Add to the reduced-motion block:

css
  .ingot-hero { position: relative; }

And to the max-width: 40rem block:

css
  .ingot-hero { min-height: 100svh; }

svh accounts for mobile browser chrome; 100vh overshoots on phones.

traces.js — full rewrite

Traces now persist their heading and cross the whole canvas, fade cleanly to zero rather than popping, and carry a glowing head.

javascript
/**
 * Generative background for the Ingot landing page.
 *
 * Manhattan-routed traces cross the canvas end to end — horizontal runs
 * with vertical jogs, a via at each turn, and a glowing head. Each trace
 * fades out by life and by proximity to its exit edge, so nothing pops.
 */

(function () {
  "use strict";

  const GRID = 24;
  const TRACES = 32;
  const SPEED = 2.0;
  const SILVER = "200, 208, 216";
  const EDGE_FADE = 220;

  let canvas = null;
  let ctx = null;
  let width = 0;
  let height = 0;
  let traces = [];
  let frame = null;

  function snap(value) {
    return Math.round(value / GRID) * GRID;
  }

  function rand(min, max) {
    return min + Math.random() * (max - min);
  }

  function newTrace() {
    const fromLeft = Math.random() < 0.5;
    const dir = fromLeft ? 1 : -1;
    const x = fromLeft ? -GRID : width + GRID;
    const y = snap(rand(GRID * 2, height - GRID * 2));
    return {
      x: x,
      y: y,
      dx: dir,
      dy: 0,
      dir: dir,
      points: [[x, y]],
      life: 0,
      maxLife: rand(1100, 1900),
      turnIn: rand(160, 420),
      width: Math.random() < 0.2 ? 2 : 1.2,
    };
  }

  function turn(trace) {
    trace.x = snap(trace.x);
    trace.y = snap(trace.y);
    trace.points.push([trace.x, trace.y]);

    if (trace.dy === 0) {
      // Horizontal → vertical. Bias away from the nearest edge.
      const room = height - trace.y;
      const goDown = trace.y < GRID * 4 ? true
                   : room < GRID * 4 ? false
                   : Math.random() < 0.5;
      trace.dy = goDown ? 1 : -1;
      trace.dx = 0;
      trace.turnIn = rand(48, 168);
    } else {
      // Vertical → resume original heading.
      trace.dx = trace.dir;
      trace.dy = 0;
      trace.turnIn = rand(160, 420);
    }
  }

  function step(trace) {
    trace.life += SPEED;
    trace.turnIn -= SPEED;
    if (trace.turnIn <= 0) turn(trace);

    trace.x += trace.dx * SPEED;
    trace.y += trace.dy * SPEED;

    // Never run off the top or bottom — reflect instead.
    if (trace.dy !== 0 && (trace.y < GRID || trace.y > height - GRID)) {
      trace.dy = -trace.dy;
    }

    const exited = trace.dir > 0 ? trace.x > width + GRID * 2
                                 : trace.x < -GRID * 2;
    return trace.life < trace.maxLife && !exited;
  }

  function alphaFor(trace) {
    const fadeIn = Math.min(1, trace.life / 18);
    const t = trace.life / trace.maxLife;
    const fadeOut = 1 - t * t * t * t;
    const toEdge = trace.dir > 0 ? width - trace.x : trace.x;
    const edge = Math.max(0, Math.min(1, toEdge / EDGE_FADE));
    return 0.9 * fadeIn * fadeOut * edge;
  }

  function drawTrace(trace) {
    const alpha = alphaFor(trace);
    if (alpha <= 0.005) return;

    const color = "rgba(" + SILVER + ", " + alpha + ")";

    ctx.strokeStyle = color;
    ctx.lineWidth = trace.width;
    ctx.beginPath();
    ctx.moveTo(trace.points[0][0], trace.points[0][1]);
    for (let i = 1; i < trace.points.length; i++) {
      ctx.lineTo(trace.points[i][0], trace.points[i][1]);
    }
    ctx.lineTo(trace.x, trace.y);
    ctx.stroke();

    ctx.fillStyle = color;
    for (let i = 1; i < trace.points.length; i++) {
      ctx.beginPath();
      ctx.arc(trace.points[i][0], trace.points[i][1], 2.4, 0, Math.PI * 2);
      ctx.fill();
    }

    // Head glow.
    ctx.save();
    ctx.shadowColor = "rgba(" + SILVER + ", " + Math.min(1, alpha * 1.4) + ")";
    ctx.shadowBlur = 10;
    ctx.fillStyle = "rgba(255, 255, 255, " + Math.min(1, alpha * 1.2) + ")";
    ctx.beginPath();
    ctx.arc(trace.x, trace.y, 2.2, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }

  function draw() {
    if (!ctx) return;
    ctx.clearRect(0, 0, width, height);
    ctx.lineCap = "square";
    ctx.lineJoin = "miter";

    for (let i = 0; i < traces.length; i++) {
      drawTrace(traces[i]);
      if (!step(traces[i])) {
        traces[i] = newTrace();
        // Stagger re-entry so replacements don't all appear at once.
        traces[i].life = -rand(0, 120);
      }
    }
    frame = requestAnimationFrame(draw);
  }

  function resize() {
    if (!canvas) return;
    const rect = canvas.parentElement.getBoundingClientRect();
    if (rect.width === 0 || rect.height === 0) {
      requestAnimationFrame(resize);
      return;
    }
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    width = Math.floor(rect.width);
    height = Math.floor(rect.height);
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    traces = [];
    for (let i = 0; i < TRACES; i++) {
      const t = newTrace();
      // Spread initial traces across the canvas so it's populated on load.
      t.x = rand(-GRID, width + GRID);
      t.points = [[t.x, t.y]];
      t.life = rand(0, t.maxLife * 0.6);
      traces.push(t);
    }
  }

  function stop() {
    if (frame !== null) {
      cancelAnimationFrame(frame);
      frame = null;
    }
    window.removeEventListener("resize", resize);
    canvas = null;
    ctx = null;
    traces = [];
  }

  function start() {
    stop();
    canvas = document.getElementById("ingot-traces");
    if (!canvas) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    ctx = canvas.getContext("2d");
    window.addEventListener("resize", resize);
    resize();
    draw();
  }

  if (typeof document$ !== "undefined" && document$.subscribe) {
    document$.subscribe(start);
  } else if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start);
  } else {
    start();
  }
})();

What changed and why:

dir persists — after a vertical jog, the trace resumes its original heading, so it actually crosses the screen instead of wandering back
Quartic fade-out — flat for most of life, then a quick clean drop to zero; nothing pops
Edge fade — traces dim as they approach their exit edge, so leaving the screen is a fade, not a cut
Reflection at top and bottom — no traces lost off the vertical edges
Initial population — traces are seeded across the canvas at random life stages, so the page loads already routed rather than empty for two seconds
Staggered replacement — a negative initial life delays re-entry
Head glow — a bright dot with shadow at each trace's leading edge
DPR-aware — crisp on high-DPI displays
20% of traces are heavier — visual hierarchy, like power rails among signal lines
landing.js — parallax against the pinned hero

With the hero sticky, the effect is inverted: content drifts up faster than the pinned background, the canvas scales gently, and the gradient deepens as the next section covers it.

javascript
(function () {
  "use strict";

  function init() {
    var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // ---- Reveal ---------------------------------------------------------
    var targets = document.querySelectorAll("[data-reveal]");
    if (reduced || !("IntersectionObserver" in window)) {
      targets.forEach(function (el) { el.classList.add("is-visible"); });
    } else {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: "0px 0px -80px 0px" });
      targets.forEach(function (el) { observer.observe(el); });
    }

    if (reduced) return;

    // ---- Hero parallax --------------------------------------------------
    var hero = document.querySelector(".ingot-hero");
    var canvas = document.getElementById("ingot-traces");
    var content = document.querySelector(".ingot-hero__content");
    var gradient = document.querySelector(".ingot-hero__gradient");
    if (!hero || !canvas || !content) return;

    var ticking = false;

    function update() {
      var heroHeight = hero.offsetHeight;
      var y = Math.max(0, window.scrollY);
      var progress = Math.min(1, y / heroHeight);

      // Content lifts away faster than the pinned background, and fades.
      content.style.transform = "translateY(" + (-y * 0.28) + "px)";
      content.style.opacity = String(1 - progress * 1.4);

      // Background recedes: slight scale, darkening.
      canvas.style.transform = "scale(" + (1 + progress * 0.08) + ")";
      canvas.style.opacity = String(0.7 * (1 - progress * 0.6));
      if (gradient) {
        gradient.style.opacity = String(1 + progress * 0.8);
      }
      ticking = false;
    }

    window.addEventListener("scroll", function () {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });

    update();
  }

  if (typeof document$ !== "undefined" && document$.subscribe) {
    document$.subscribe(init);
  } else if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
One thing to verify

Sticky positioning breaks if any ancestor has overflow: hidden or overflow: auto. You've already set .md-tabs to overflow: visible; check .ingot-landing and .md-container in DevTools too. If the hero scrolls away normally instead of staying pinned, that's the cause — find the ancestor with the overflow rule and override it in the template's <style> block.

If sticky genuinely won't cooperate with Material's layout, dropping position: sticky and z-index: 0 from .ingot-hero falls back to the plain parallax cleanly. Everything else still works.
