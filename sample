traces.js — full rewrite

Two structural changes: initial traces are simulated forward from the edge so they arrive with a real routed tail, and rendering is tail-first with per-segment gradients so the trail dims with distance from the head.

javascript
/**
 * Generative background for the Ingot landing page.
 *
 * Manhattan-routed traces cross the canvas end to end. Each is drawn as a
 * comet: full brightness for a span behind the head, then fading with
 * distance, then gone — so old path is culled rather than accumulating.
 * When a trace reaches the end of its life the head stops and the tail
 * retracts into it. Traces approaching their exit edge fade out. Nothing
 * pops.
 */

(function () {
  "use strict";

  const GRID = 24;
  const TRACES = 30;
  const SPEED = 2.0;
  const SILVER = "200, 208, 216";

  const TAIL_FULL = 520;   // px behind the head at full brightness
  const TAIL_FADE = 360;   // px over which the tail fades to nothing
  const EDGE_FADE = 240;   // px from exit edge over which the trace dims
  const RETRACT = 3.2;     // px/frame the tail shortens after the head stops

  let canvas = null;
  let ctx = null;
  let width = 0;
  let height = 0;
  let traces = [];
  let frame = null;

  const snap = (v) => Math.round(v / GRID) * GRID;
  const rand = (a, b) => a + Math.random() * (b - a);

  // ---- Traces -----------------------------------------------------------

  function newTrace() {
    const fromLeft = Math.random() < 0.5;
    const dir = fromLeft ? 1 : -1;
    const x = fromLeft ? -GRID : width + GRID;
    const y = snap(rand(GRID * 2, height - GRID * 2));
    return {
      x, y,
      dx: dir, dy: 0, dir,
      points: [[x, y]],
      speed: SPEED * rand(0.85, 1.2),
      life: 0,
      maxLife: rand(1400, 2600),
      turnIn: rand(160, 440),
      width: Math.random() < 0.2 ? 2 : 1.2,
      retracting: 0,           // frames since the head stopped
    };
  }

  function turn(t) {
    t.x = snap(t.x);
    t.y = snap(t.y);
    t.points.push([t.x, t.y]);

    if (t.dy === 0) {
      const nearTop = t.y < GRID * 4;
      const nearBottom = height - t.y < GRID * 4;
      const goDown = nearTop ? true : nearBottom ? false : Math.random() < 0.5;
      t.dy = goDown ? 1 : -1;
      t.dx = 0;
      t.turnIn = rand(48, 168);
    } else {
      t.dx = t.dir;
      t.dy = 0;
      t.turnIn = rand(160, 440);
    }
  }

  function advance(t) {
    t.life += t.speed;
    t.turnIn -= t.speed;
    if (t.turnIn <= 0) turn(t);

    t.x += t.dx * t.speed;
    t.y += t.dy * t.speed;

    if (t.dy !== 0 && (t.y < GRID || t.y > height - GRID)) t.dy = -t.dy;
  }

  function exited(t) {
    return t.dir > 0 ? t.x > width + GRID * 2 : t.x < -GRID * 2;
  }

  /** One simulation step. Returns false when the trace should be replaced. */
  function step(t) {
    if (t.life >= t.maxLife || exited(t)) {
      t.retracting += 1;
      return t.retracting * RETRACT < TAIL_FULL + TAIL_FADE;
    }
    advance(t);
    return true;
  }

  // ---- Rendering --------------------------------------------------------

  function edgeAlpha(t) {
    const toEdge = t.dir > 0 ? width - t.x : t.x;
    return Math.max(0, Math.min(1, toEdge / EDGE_FADE));
  }

  function tailAlphaAt(distance, tailFull, tailEnd) {
    if (distance <= tailFull) return 1;
    if (distance >= tailEnd) return 0;
    const u = (distance - tailFull) / (tailEnd - tailFull);
    return 1 - u * u;                     // ease-out
  }

  function drawTrace(t) {
    const fadeIn = Math.min(1, t.life / 20);
    const base = 0.9 * fadeIn * edgeAlpha(t);
    if (base <= 0.005) return;

    // Retracting shortens the tail from the far end.
    const shrink = t.retracting * RETRACT;
    const tailFull = Math.max(0, TAIL_FULL - shrink);
    const tailEnd = Math.max(0, TAIL_FULL + TAIL_FADE - shrink);
    if (tailEnd <= 0) return;

    const path = [...t.points, [t.x, t.y]];
    ctx.lineWidth = t.width;

    // Walk from the head backward, drawing each segment with a gradient
    // by distance from the head. Cull points beyond the tail.
    let cumulative = 0;
    let keepFrom = 0;

    for (let i = path.length - 1; i > 0; i--) {
      const [hx, hy] = path[i];       // nearer the head
      const [tx, ty] = path[i - 1];   // nearer the tail
      const length = Math.abs(hx - tx) + Math.abs(hy - ty);
      if (length === 0) continue;

      const dNear = cumulative;
      const dFar = cumulative + length;
      cumulative = dFar;

      if (dNear >= tailEnd) { keepFrom = i; break; }

      const aNear = base * tailAlphaAt(dNear, tailFull, tailEnd);
      const aFar = base * tailAlphaAt(Math.min(dFar, tailEnd), tailFull, tailEnd);

      // Clip the far end to where alpha reaches zero so we don't draw
      // invisible length.
      let ex = tx, ey = ty;
      if (dFar > tailEnd) {
        const f = (tailEnd - dNear) / length;
        ex = hx + (tx - hx) * f;
        ey = hy + (ty - hy) * f;
        keepFrom = i - 1;
      }

      const grad = ctx.createLinearGradient(hx, hy, ex, ey);
      grad.addColorStop(0, `rgba(${SILVER}, ${aNear})`);
      grad.addColorStop(1, `rgba(${SILVER}, ${aFar})`);
      ctx.strokeStyle = grad;
      ctx.beginPath();
      ctx.moveTo(hx, hy);
      ctx.lineTo(ex, ey);
      ctx.stroke();
    }

    if (keepFrom > 0) t.points.splice(0, keepFrom);

    // Vias at turns still within the visible tail.
    cumulative = 0;
    for (let i = path.length - 1; i > 0; i--) {
      cumulative += Math.abs(path[i][0] - path[i - 1][0]) + Math.abs(path[i][1] - path[i - 1][1]);
      if (cumulative >= tailEnd) break;
      const a = base * tailAlphaAt(cumulative, tailFull, tailEnd);
      if (a < 0.02 || i - 1 === 0) continue;
      ctx.fillStyle = `rgba(${SILVER}, ${a})`;
      ctx.beginPath();
      ctx.arc(path[i - 1][0], path[i - 1][1], 2.4, 0, Math.PI * 2);
      ctx.fill();
    }

    // Head glow — dims as the trace retracts.
    const headAlpha = base * (tailEnd / (TAIL_FULL + TAIL_FADE));
    if (headAlpha > 0.02) {
      ctx.save();
      ctx.shadowColor = `rgba(${SILVER}, ${Math.min(1, headAlpha * 1.4)})`;
      ctx.shadowBlur = 10;
      ctx.fillStyle = `rgba(255, 255, 255, ${Math.min(1, headAlpha * 1.2)})`;
      ctx.beginPath();
      ctx.arc(t.x, t.y, 2.2, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }
  }

  function draw() {
    if (!ctx) return;
    ctx.clearRect(0, 0, width, height);
    ctx.lineCap = "butt";
    ctx.lineJoin = "miter";

    for (let i = 0; i < traces.length; i++) {
      drawTrace(traces[i]);
      if (!step(traces[i])) {
        traces[i] = newTrace();
        traces[i].life = -rand(0, 160);   // stagger re-entry
      }
    }
    frame = requestAnimationFrame(draw);
  }

  // ---- Lifecycle --------------------------------------------------------

  function seed() {
    traces = [];
    for (let i = 0; i < TRACES; i++) {
      const t = newTrace();
      // Simulate forward so the trace arrives with a real routed tail,
      // instead of appearing mid-canvas as a point.
      const steps = Math.floor(rand(0, (width / SPEED) * 0.9));
      for (let s = 0; s < steps && !exited(t); s++) advance(t);
      if (exited(t)) { i--; continue; }
      traces.push(t);
    }
  }

  function resize() {
    if (!canvas) return;
    const rect = canvas.parentElement.getBoundingClientRect();
    if (rect.width === 0 || rect.height === 0) {
      requestAnimationFrame(resize);
      return;
    }
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    width = Math.floor(rect.width);
    height = Math.floor(rect.height);
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    seed();
  }

  function stop() {
    if (frame !== null) cancelAnimationFrame(frame);
    frame = null;
    window.removeEventListener("resize", resize);
    canvas = ctx = null;
    traces = [];
  }

  function start() {
    stop();
    canvas = document.getElementById("ingot-traces");
    if (!canvas) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    ctx = canvas.getContext("2d");
    window.addEventListener("resize", resize);
    resize();
    draw();
  }

  if (typeof document$ !== "undefined" && document$.subscribe) {
    document$.subscribe(start);
  } else if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start);
  } else {
    start();
  }
})();
What each fix does

Mid-screen starts — seed() creates each trace at its edge and runs advance() a random number of times without drawing. On load, every trace has a genuine routed path behind it. Anything that would have already exited gets rerolled.

Tail fade — the polyline is walked from the head backward. The first 520px stay at full alpha, the next 360px fade with an ease-out curve, and anything beyond is culled from points so the array never grows. Each segment is a linear gradient, so the fade is smooth even across a single long run.

Burn-out — when a trace hits maxLife or exits, the head stops and retracting counts up. Each frame shortens the visible tail from the far end until nothing remains, then the trace is replaced. Combined with the edge fade, there's no moment where a trace disappears abruptly.

Per-trace speed — slight variation so the field doesn't move in lockstep.

Tuning knobs

TAIL_FULL and TAIL_FADE are the ones to adjust by eye. Longer TAIL_FULL means more line on screen at once; longer TAIL_FADE means a softer comet. If it reads as too sparse, raise TRACES to 40 — the culling keeps per-trace draw cost bounded, so it scales fine.

Just do one more pass over everything, clean up anything you wish. Take some style liberties. Make any improvements you can think of at all (feel free to add dummy sections I will fill out later if that allows you more creative freedom). Design a better logo if you wish. Really take some time on this final pass and drop all files.

Full pass. Seven files. I've added a fixed nav (the landing had no navigation once Material's header was hidden), a tools strip, a how-it-works flow, an animated profiles diagram, a roadmap placeholder, and a footer — plus cursor-tracking glow on cards, sequential terminal reveal, and animated stat counters.

