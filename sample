"""Build profile resolution.

Profiles are defined at the project root and apply to every block. Ingot
ships defaults for `fast`, `debug`, and `coverage`; a project may override
them by name or add its own. A block may further override in its manifest
for something specific to that block. Any profile may inherit another.
"""

from __future__ import annotations

import hashlib
import tomllib
from dataclasses import dataclass, field
from pathlib import Path

from ingot.manifest.discover import MANIFEST_NAME
from ingot.manifest.schema import ManifestError, ProfileConfig

DEFAULT_PROFILE = "fast"

BUILTIN: dict[str, ProfileConfig] = {
    "fast": ProfileConfig(
        description="Regressions and sanity checks. No debug access, no coverage.",
    ),
    "debug": ProfileConfig(
        description="Failure investigation in Verdi. Waveforms and source-level debug.",
        elab_args=["-debug_access+all", "-kdb"],
    ),
    "coverage": ProfileConfig(
        description="Coverage closure. Instrumented, slower. Testbench excluded.",
        coverage=True,
    ),
}


@dataclass(frozen=True)
class Profile:
    """A fully resolved profile."""

    name: str
    description: str
    elab_args: tuple[str, ...]
    defines: dict[str, str] = field(default_factory=dict)
    coverage: bool = False
    coverage_metrics: str = "line+cond+fsm+tgl+branch"
    coverage_scope: str = "dut"


def define_key(defines: dict[str, str]) -> str:
    """Directory key for an analysis with the given effective defines.

    Analysis output depends on sources and defines. Builds with identical
    defines share one analysis; the common case — no defines — is `base`.
    """
    if not defines:
        return "base"
    joined = "|".join(f"{k}={defines[k]}" for k in sorted(defines))
    return hashlib.sha256(joined.encode()).hexdigest()[:12]


def _read_profiles_section(path: Path) -> dict[str, ProfileConfig]:
    if not path.is_file():
        return {}
    with path.open("rb") as handle:
        data = tomllib.load(handle)
    configs: dict[str, ProfileConfig] = {}
    for name, raw in data.get("profiles", {}).items():
        try:
            configs[name] = ProfileConfig.model_validate(raw)
        except Exception as error:
            raise ManifestError(f"{path}: [profiles.{name}]: {error}") from error
    return configs


def load_profile_configs(
    root: Path, block_root: Path | None = None
) -> dict[str, ProfileConfig]:
    """Built-ins, overridden by the project, overridden by the block."""
    configs = dict(BUILTIN)
    configs.update(_read_profiles_section(root / MANIFEST_NAME))
    if block_root is not None:
        configs.update(_read_profiles_section(block_root / MANIFEST_NAME))
    return configs


def resolve_profile(name: str, configs: dict[str, ProfileConfig]) -> Profile:
    """Resolve a profile, applying inheritance ancestors-first."""
    if name not in configs:
        known = ", ".join(sorted(configs))
        raise ManifestError(f"unknown profile {name!r}.\n  Known profiles: {known}")

    chain: list[ProfileConfig] = []
    seen: list[str] = []
    current: str | None = name
    while current is not None:
        if current in seen:
            raise ManifestError(
                f"profile inheritance cycle: {' -> '.join([*seen, current])}"
            )
        if current not in configs:
            raise ManifestError(
                f"profile {seen[-1]!r} inherits unknown profile {current!r}"
            )
        seen.append(current)
        chain.append(configs[current])
        current = configs[current].inherits
    chain.reverse()

    elab_args: list[str] = []
    defines: dict[str, str] = {}
    for config in chain:
        elab_args.extend(config.elab_args)
        defines.update(config.defines)

    leaf = chain[-1]
    return Profile(
        name=name,
        description=leaf.description or next(
            (c.description for c in reversed(chain) if c.description), ""
        ),
        elab_args=tuple(elab_args),
        defines=defines,
        coverage=any(c.coverage for c in chain),
        coverage_metrics=leaf.coverage_metrics,
        coverage_scope=leaf.coverage_scope,
    )


def load_profile(
    root: Path, name: str = DEFAULT_PROFILE, block_root: Path | None = None
) -> Profile:
    return resolve_profile(name, load_profile_configs(root, block_root))


def list_profiles(root: Path, block_root: Path | None = None) -> list[Profile]:
    configs = load_profile_configs(root, block_root)
    return [resolve_profile(name, configs) for name in sorted(configs)]
