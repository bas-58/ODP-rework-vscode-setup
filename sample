from ingot.vcs.build import BuildContext, BuildError, BuildOptions

FLOW_ERRORS = (ManifestError, ToolNotFoundError, BuildError)


def fail(message: str) -> typer.Exit:
    typer.secho(f"error: {message}", fg=typer.colors.RED, err=True)
    return typer.Exit(1)


def context(block: str, profile: str, options: BuildOptions) -> tuple[CompilePlan, Profile, BuildContext]:
    plan = resolve_block(block)
    prof = load_profile(plan.root, profile, block_root=plan.unit.root)
    return plan, prof, BuildContext(plan=plan, profile=prof, options=options)


def repro_hint(block: str, test: str, seed: int) -> str:
    return (
        f"  reproduce:  ingot sim {block} -t {test} -s {seed}\n"
        f"  debug:      ingot sim {block} -t {test} -s {seed} -p debug --waves"
    )
