docs/javascripts/docs.js

Mirrors the section onto <body> so the header and sidebar can respond, and drives the tutorial reading-progress bar.

javascript
/**
 * Docs page behaviour: section attribute on <body>, reading progress.
 */

(function () {
  "use strict";

  var progress = null;

  function ensureProgressBar() {
    if (progress) return progress;
    progress = document.createElement("div");
    progress.className = "ingot-progress";
    progress.setAttribute("aria-hidden", "true");
    document.body.appendChild(progress);
    return progress;
  }

  function updateProgress() {
    if (!progress) return;
    var el = document.documentElement;
    var max = el.scrollHeight - el.clientHeight;
    var p = max > 0 ? el.scrollTop / max : 0;
    progress.style.transform = "scaleX(" + Math.max(0, Math.min(1, p)) + ")";
  }

  function init() {
    var page = document.querySelector(".ingot-page[data-section]");
    var section = page ? page.getAttribute("data-section") : "";
    document.body.setAttribute("data-ingot-section", section);

    ensureProgressBar();
    updateProgress();
  }

  window.addEventListener("scroll", updateProgress, { passive: true });

  if (typeof document$ !== "undefined" && document$.subscribe) {
    document$.subscribe(init);
  } else if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
