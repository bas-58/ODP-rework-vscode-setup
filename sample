"""Run one simulation."""

from __future__ import annotations

from typing import Annotated

import typer

from ingot.commands._common import FLOW_ERRORS, context, fail, repro_hint
from ingot.vcs.build import BuildOptions, build
from ingot.vcs.sim import simulate

app = typer.Typer(help="Run a single test.")


@app.callback(invoke_without_command=True)
def sim_command(
    block: Annotated[str, typer.Argument()],
    test: Annotated[str, typer.Option("--test", "-t")] = "smoke",
    seed: Annotated[int | None, typer.Option("--seed", "-s")] = None,
    profile: Annotated[str, typer.Option("--profile", "-p")] = "fast",
    waves: Annotated[bool, typer.Option("--waves", help="Dump waveforms. Implies -p debug.")] = False,
    dry_run: Annotated[bool, typer.Option("--dry-run")] = False,
) -> None:
    """Run one test against a block, building first if needed.

    Pass or fail is judged from the log, not the exit code — VCS exits
    zero on `$fatal`. The seed is always printed so a failure reproduces.
    """
    if waves and profile == "fast":
        typer.secho("--waves requires debug access; using profile 'debug'", err=True)
        profile = "debug"

    try:
        plan, _, ctx = context(block, profile, BuildOptions(dry_run=dry_run))
        artifact, _ = build(ctx)
        test_config = plan.unit.manifest.tests.get(test)
        plusargs = tuple(test_config.plusargs) if test_config else ()
        result = simulate(artifact, plan.root, test, seed, plusargs, waves, dry_run)
    except FLOW_ERRORS as error:
        raise fail(str(error)) from error

    if dry_run:
        typer.echo(" ".join(result.run.argv))
        return

    status, colour = ("PASS", typer.colors.GREEN) if result.passed else ("FAIL", typer.colors.RED)
    typer.secho(f"{status}  {block}/{test}  seed={result.seed}  {result.run.duration_s:.1f}s", fg=colour)
    if not result.passed:
        typer.echo(f"  {result.reason}")
        typer.echo(f"  log:        {result.log}")
        typer.echo(repro_hint(block, test, result.seed))
        raise typer.Exit(1)
