"""Running simulations against an elaborated artifact."""

from __future__ import annotations

import random
import re
from dataclasses import dataclass
from pathlib import Path

from ingot.exec.run import ToolRun, history_path, run_tool
from ingot.vcs.build import Artifact

#: VCS exits zero on `$fatal`; the log is authoritative.
FAILURE_PATTERNS = (
    re.compile(r"^Fatal:", re.MULTILINE),
    re.compile(r"^Error-\[", re.MULTILINE),
    re.compile(r"INGOT_FAIL"),
    re.compile(r"^UVM_(?:ERROR|FATAL)\s+@", re.MULTILINE),
    re.compile(r"^UVM_(?:ERROR|FATAL)\s*:\s*[1-9]\d*", re.MULTILINE),
)


@dataclass(frozen=True)
class SimResult:
    test: str
    seed: int
    passed: bool
    run: ToolRun
    reason: str

    @property
    def log(self) -> Path:
        return Path(self.run.log)


def judge(log_text: str, returncode: int) -> tuple[bool, str]:
    """Decide pass or fail from a log. Heuristic; errs toward failure."""
    if returncode != 0:
        return False, f"exit status {returncode}"
    if not log_text.strip():
        return False, "empty log"
    for pattern in FAILURE_PATTERNS:
        match = pattern.search(log_text)
        if match:
            return False, log_text[match.start():].splitlines()[0].strip()[:120]
    return True, "ok"


def simulate(
    artifact: Artifact,
    root: Path,
    test: str,
    seed: int | None = None,
    plusargs: tuple[str, ...] = (),
    waves: bool = False,
    dry_run: bool = False,
) -> SimResult:
    """Run one test. The seed is always recorded so any failure reproduces."""
    if seed is None:
        seed = random.randint(1, 2**31 - 1)

    run_dir = Path(artifact.build_dir) / "runs" / f"{test}_{seed}"
    argv = [
        str(artifact.simv),
        f"+UVM_TESTNAME={test}",
        f"+ntb_random_seed={seed}",
        "-l", "sim.log",
    ]
    if waves:
        argv.append("+waves")
    argv.extend(plusargs)

    run = run_tool(
        tool="simv", phase="simulate", argv=argv,
        cwd=run_dir, log=run_dir / "sim.log",
        metadata={"block": artifact.block, "profile": artifact.profile,
                  "test": test, "seed": str(seed)},
        record_to=history_path(root), dry_run=dry_run,
    )
    if dry_run:
        return SimResult(test, seed, True, run, "dry run")

    log_text = Path(run.log).read_text(errors="replace")
    passed, reason = judge(log_text, run.returncode)
    return SimResult(test, seed, passed, run, reason)
