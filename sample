css
/* ---- Lifecycle -------------------------------------------------------- */

.ingot-section--lifecycle {
  background: var(--ink-2);
  padding-top: 4rem;
}

.ingot-lifecycle {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  list-style: none;
  margin: 0;
  padding: 0;
  border: 1px solid var(--line);
  border-radius: 0.75rem;
  overflow: hidden;
  background: rgba(10, 12, 14, 0.4);
}

.ingot-stage {
  position: relative;
  padding: 1.75rem 1.5rem 2rem;
  border-right: 1px solid var(--line);
}

.ingot-stage:last-child {
  border-right: none;
}

.ingot-stage::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: rgba(200, 208, 216, 0.15);
}

.ingot-stage.is-live::before {
  background: linear-gradient(90deg, var(--silver), rgba(200, 208, 216, 0.3));
}

.ingot-stage__badge {
  display: inline-block;
  font-size: 0.65rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 1rem;
}

.ingot-stage.is-live .ingot-stage__badge {
  color: var(--ok);
}

.ingot-stage h3 {
  font-size: 1.15rem;
  font-weight: 600;
  margin: 0 0 0.5rem;
  color: #fff;
}

.ingot-stage:not(.is-live) h3 {
  color: var(--silver-2);
}

.ingot-stage p {
  font-size: 0.85rem;
  line-height: 1.55;
  color: var(--muted);
  margin: 0;
}

/* ---- Three-column feature grid ---------------------------------------- */

.ingot-grid--three {
  grid-template-columns: repeat(3, 1fr);
}

.ingot-card--accent {
  border-color: rgba(200, 208, 216, 0.28);
  background: linear-gradient(160deg, rgba(200, 208, 216, 0.07), rgba(200, 208, 216, 0.02));
}

/* ---- Agents ----------------------------------------------------------- */

.ingot-section--agents {
  background:
    radial-gradient(ellipse 60% 50% at 80% 0%, rgba(200, 208, 216, 0.05), transparent 60%),
    var(--ink-3);
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.ingot-agents__head {
  max-width: 44rem;
  margin-bottom: 3.5rem;
}

.ingot-agents__head .ingot-section__title {
  margin-bottom: 1.25rem;
  max-width: none;
}

.ingot-agents__lede {
  font-size: 1.05rem;
  line-height: 1.65;
  color: var(--muted);
  margin: 0;
}

.ingot-agents__lede code,
.ingot-point code {
  font-family: var(--mono);
  font-size: 0.86em;
  color: var(--silver);
  background: rgba(200, 208, 216, 0.08);
  padding: 0.1em 0.4em;
  border-radius: 0.25rem;
}

.ingot-agents__grid {
  display: grid;
  grid-template-columns: 1fr 1.15fr;
  gap: 3rem;
  align-items: start;
}

.ingot-agents__points {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.75rem 2rem;
}

.ingot-point h3 {
  font-size: 0.95rem;
  font-weight: 600;
  margin: 0 0 0.4rem;
  color: #fff;
}

.ingot-point p {
  font-size: 0.85rem;
  line-height: 1.6;
  color: var(--muted);
  margin: 0;
}

.ingot-terminal--flat {
  transform: none;
}

.ingot-terminal--flat:hover {
  transform: none;
}

.ingot-terminal__body--json {
  font-size: 0.74rem;
}

.ingot-terminal__body--json .k { color: var(--silver-2); }
.ingot-terminal__body--json .s { color: #B6D8A8; }

/* ---- Responsive additions --------------------------------------------- */

@media (max-width: 60rem) {
  .ingot-grid--three { grid-template-columns: repeat(2, 1fr); }
  .ingot-lifecycle { grid-template-columns: repeat(2, 1fr); }
  .ingot-stage:nth-child(2) { border-right: none; }
  .ingot-stage:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
  .ingot-agents__grid { grid-template-columns: 1fr; }
}

@media (max-width: 40rem) {
  .ingot-grid--three { grid-template-columns: 1fr; }
  .ingot-lifecycle { grid-template-columns: 1fr; }
  .ingot-stage { border-right: none; border-bottom: 1px solid var(--line); }
  .ingot-stage:last-child { border-bottom: none; }
  .ingot-agents__points { grid-template-columns: 1fr; }
}

