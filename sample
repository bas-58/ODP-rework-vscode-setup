def write_sources_filelist(
    sources: tuple[Source, ...] | list[Source],
    incdirs: tuple[Path, ...],
    defines: dict[str, str],
    path: Path,
    language: Language,
    label: str,
) -> Path:
    """Write a filelist for one unit and one language.

    Include directories and defines are omitted for VHDL, which has no
    preprocessor.
    """
    compiled = [s for s in sources if s.compiled and s.language is language]
    path.parent.mkdir(parents=True, exist_ok=True)

    lines = [f"// generated by ingot for {label} ({language})", f"// {len(compiled)} sources", ""]
    if language is not Language.VHDL:
        lines.extend(f"+incdir+{d}" for d in incdirs)
        for key in sorted(defines):
            value = defines[key]
            lines.append(f"+define+{key}={value}" if value else f"+define+{key}")
        if incdirs or defines:
            lines.append("")
    lines.extend(str(s.path) for s in compiled)
    path.write_text("\n".join(lines) + "\n")
    return path
