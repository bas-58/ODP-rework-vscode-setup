Parallax and scroll-reveal. Add to extra_javascript alongside traces.js.

javascript
/**
 * Landing page motion: parallax on the hero canvas, reveal-on-scroll for
 * sections. Both respect prefers-reduced-motion.
 */

(function () {
  "use strict";

  function init() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.querySelectorAll("[data-reveal]").forEach(function (el) {
        el.classList.add("is-visible");
      });
      return;
    }

    // ---- Reveal ---------------------------------------------------------
    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -60px 0px" }
    );
    document.querySelectorAll("[data-reveal]").forEach(function (el) {
      observer.observe(el);
    });

    // ---- Parallax -------------------------------------------------------
    var canvas = document.getElementById("ingot-traces");
    var hero = canvas ? canvas.closest(".ingot-hero") : null;
    if (!canvas || !hero) return;

    var ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        var heroHeight = hero.offsetHeight;
        var y = window.scrollY;
        if (y < heroHeight) {
          canvas.style.transform = "translateY(" + y * 0.35 + "px)";
        }
        ticking = false;
      });
    }
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  if (typeof document$ !== "undefined" && document$.subscribe) {
    document$.subscribe(init);
  } else if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
