         ================================================================ -->
    <section class="ingot-section ingot-section--terminal" data-reveal>
      <div class="ingot-container ingot-split">
        <div class="ingot-split__text">
          <p class="ingot-eyebrow">The loop</p>
          <h2 class="ingot-section__title">Build once. Debug without rebuilding.</h2>
          <p>When a seed fails, the output already contains the command to
             reproduce it and the command to open it with waveforms. The
             debug profile reuses every analysis, so you pay for one
             elaboration and nothing else.</p>
          <a href="{{ 'guides/debug-a-failure/' | url }}" class="ingot-link">Debug a failure</a>
        </div>

        <div class="ingot-terminal" data-terminal>
          <div class="ingot-terminal__bar">
            <span></span><span></span><span></span>
            <em>bash</em>
          </div>
<pre class="ingot-terminal__body"><span class="line"><span class="p">$</span> ingot sim exemplar -t smoke</span>
<span class="line"><span class="fail">FAIL</span>  exemplar/smoke  seed=1847362  4.2s</span>
<span class="line">  Fatal: exemplar_tb.sv:45 read data mismatch</span>
<span class="line">  log:        build/exemplar/fast/runs/smoke_1847362/sim.log</span>
<span class="line">  reproduce:  ingot sim exemplar -t smoke -s 1847362</span>
<span class="line">  debug:      ingot sim exemplar -t smoke -s 1847362 -p debug --waves</span>
<span class="line"> </span>
<span class="line"><span class="p">$</span> ingot sim exemplar -t smoke -s 1847362 -p debug --waves</span>
<span class="line">  vcs elaborate    <span class="t">58.0s</span>  ok   <span class="c">← analysis reused</span></span>
<span class="line"><span class="fail">FAIL</span>  exemplar/smoke  seed=1847362  6.1s   <span class="c">waves: runs/smoke_1847362/dump.fsdb</span></span></pre>
        </div>
      </div>
    </section>

    <!-- ================================================================
         Stats
         ================================================================ -->
    <section class="ingot-section ingot-section--stats" data-reveal>
      <div class="ingot-container ingot-stats">
        <div class="ingot-stat">
          <strong data-count="1" data-suffix="×">1×</strong>
          <span>analysis per unit, shared by every consumer</span>
        </div>
        <div class="ingot-stat">
          <strong data-count="4" data-suffix=" lines">4 lines</strong>
          <span>of TOML to define a block</span>
        </div>
        <div class="ingot-stat">
          <strong data-count="100" data-suffix="%">100%</strong>
          <span>of failures print a reproduce command</span>
        </div>
      </div>
    </section>

    <!-- ================================================================
         Roadmap (placeholder — fill in as capabilities land)
         ================================================================ -->
    <section class="ingot-section ingot-section--roadmap" data-reveal>
      <div class="ingot-container">
        <p class="ingot-eyebrow">Roadmap</p>
        <h2 class="ingot-section__title">Where it's going.</h2>

        <ul class="ingot-roadmap">
          <li class="ingot-roadmap__item is-done">
            <span class="ingot-roadmap__marker"></span>
            <div>
              <h3>VCS flow with profiles</h3>
              <p>Build, sim, regress. Per-unit libraries, shared analysis, reproducible seeds.</p>
            </div>
          </li>
          <li class="ingot-roadmap__item is-active">
            <span class="ingot-roadmap__marker"></span>
            <div>
              <h3>Fast gate with slang</h3>
              <p>Elaboration-level checks in seconds, before VCS ever runs.</p>
            </div>
          </li>
          <li class="ingot-roadmap__item">
            <span class="ingot-roadmap__marker"></span>
            <div>
              <h3>VC Formal integration</h3>
              <p>Prove properties from the same manifest. Same checkers, sim and formal.</p>
            </div>
          </li>
          <li class="ingot-roadmap__item">
            <span class="ingot-roadmap__marker"></span>
            <div>
              <h3>Coverage merge and trend</h3>
              <p>Nightly closure numbers, published beside the docs.</p>
            </div>
          </li>
          <li class="ingot-roadmap__item">
            <span class="ingot-roadmap__marker"></span>
            <div>
              <h3>Publishing</h3>
              <p>Libraries and block templates as versioned packages. <code>ingot new-project</code>.</p>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <!-- ================================================================
         CTA
         ================================================================ -->
    <section class="ingot-section ingot-section--cta" data-reveal>
      <div class="ingot-container ingot-cta">
        <h2>Start with your first block.</h2>
        <p>Ten minutes from clone to a passing regression.</p>
        <div class="ingot-hero__actions ingot-cta__actions">
          <a href="{{ 'start/first-block/' | url }}" class="ingot-btn ingot-btn--primary">
            Read the tutorial
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href="{{ 'reference/cli/' | url }}" class="ingot-btn ingot-btn--ghost">CLI reference</a>
        </div>
      </div>
    </section>

    <!-- ================================================================
         Footer
         ================================================================ -->
    <footer class="ingot-footer">
      <div class="ingot-container ingot-footer__inner">
        <a class="ingot-lockup ingot-lockup--small" href="{{ '.' | url }}">
          <img src="{{ 'assets/logo.svg' | url }}" alt="">
          <span>Ingot</span>
        </a>
        <nav class="ingot-footer__links" aria-label="Footer">
          <a href="{{ 'start/first-block/' | url }}">Getting started</a>
          <a href="{{ 'concepts/philosophy/' | url }}">Concepts</a>
          <a href="{{ 'reference/cli/' | url }}">Reference</a>
          <a href="{{ 'contributing/' | url }}">Contributing</a>
          <a href="{{ 'decisions/0001-repo-structure/' | url }}">Decisions</a>
        </nav>
        <p class="ingot-footer__meta">
          Silicon design and verification platform for circuitware.
        </p>
      </div>
    </footer>

  </div>
</div>
{% endblock %}

