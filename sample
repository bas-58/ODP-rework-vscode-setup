python
"""Analysis and elaboration with VCS.

Every unit — library or block — is analyzed into its own VCS library,
keyed by the effective define set, and shared by everything that depends
on it. Elaboration is per block, per profile. A `synopsys_sim.setup`
generated into each working directory maps library names to analysis
directories.

    build/
    ├── ing/an/base/AN.DB              shared by every block depending on ing
    └── exemplar/
        ├── an/base/AN.DB
        ├── fast/{synopsys_sim.setup, csrc/, simv, artifact.json, runs/}
        └── debug/...
"""

from __future__ import annotations

import hashlib
import json
import subprocess
from dataclasses import asdict, dataclass
from pathlib import Path

from ingot.exec.resolve import resolve_tool
from ingot.exec.run import ToolRun, history_path, run_tool
from ingot.manifest.discover import Unit
from ingot.manifest.order import order_sources
from ingot.manifest.profiles import Profile, define_key
from ingot.manifest.resolve import CompilePlan, write_sources_filelist
from ingot.manifest.schema import Language

ARTIFACT_FILE = "artifact.json"
SETUP_FILE = "synopsys_sim.setup"
HIER_FILE = "cov.hier"
STAMP_FILE = ".analyzed"
SIMV = "simv"


class BuildError(RuntimeError):
    """Raised when analysis or elaboration fails."""

    def __init__(self, message: str, run: ToolRun | None = None) -> None:
        super().__init__(message)
        self.run = run


@dataclass(frozen=True)
class BuildOptions:
    """Per-invocation options layered on top of a profile."""

    incremental: bool = True
    jobs: int = 1
    extra_elab_args: tuple[str, ...] = ()
    dry_run: bool = False


@dataclass(frozen=True)
class BuildContext:
    """Everything a build needs, resolved once."""

    plan: CompilePlan
    profile: Profile
    options: BuildOptions

    @property
    def root(self) -> Path:
        return self.plan.root

    @property
    def build_root(self) -> Path:
        return self.root / "build"

    @property
    def defines(self) -> dict[str, str]:
        """Effective defines: dependencies, then block, then profile."""
        merged: dict[str, str] = {}
        for unit in self.plan.units:
            merged.update(unit.manifest.defines)
        merged.update(self.profile.defines)
        return merged

    @property
    def analysis_key(self) -> str:
        return define_key(self.defines)

    @property
    def incdirs(self) -> tuple[Path, ...]:
        return self.plan.incdirs

    def analysis_dir(self, unit: Unit) -> Path:
        return self.build_root / unit.name / "an" / self.analysis_key

    @property
    def profile_dir(self) -> Path:
        return self.build_root / self.plan.name / self.profile.name

    @property
    def simv(self) -> Path:
        return self.profile_dir / SIMV

    def unit_hash(self, unit: Unit) -> str:
        """Digest of one unit's analysis inputs."""
        digest = hashlib.sha256()
        for source in unit.sources:
            stat = source.path.stat()
            digest.update(str(source.path).encode())
            digest.update(str(stat.st_size).encode())
            digest.update(str(int(stat.st_mtime)).encode())
        for directory in self.incdirs:
            digest.update(str(directory).encode())
        for key in sorted(self.defines):
            digest.update(f"{key}={self.defines[key]}".encode())
        return digest.hexdigest()[:16]

    def options_hash(self) -> str:
        """Digest of everything besides sources that affects the binary."""
        parts = [
            f"profile={self.profile.name}",
            *self.profile.elab_args,
            *self.options.extra_elab_args,
            f"coverage={self.profile.coverage}",
            f"metrics={self.profile.coverage_metrics}",
            f"scope={self.profile.coverage_scope}",
            f"top={self.plan.top}",
        ]
        return hashlib.sha256("|".join(parts).encode()).hexdigest()[:12]


@dataclass(frozen=True)
class Artifact:
    """An elaborated simulation binary and what produced it."""

    block: str
    profile: str
    path: str
    build_dir: str
    manifest_hash: str
    options_hash: str
    tool_version: str
    top: str

    @property
    def simv(self) -> Path:
        return Path(self.path)

    def save(self) -> Path:
        target = Path(self.build_dir) / ARTIFACT_FILE
        target.write_text(json.dumps(asdict(self), indent=2) + "\n")
        return target

    @classmethod
    def load(cls, profile_dir: Path) -> Artifact | None:
        target = profile_dir / ARTIFACT_FILE
        if not target.is_file():
            return None
        try:
            return cls(**json.loads(target.read_text()))
        except (json.JSONDecodeError, TypeError):
            return None

    def is_current(self, ctx: BuildContext) -> bool:
        return (
            self.simv.is_file()
            and self.manifest_hash == ctx.plan.content_hash()
            and self.options_hash == ctx.options_hash()
        )


def vcs_version() -> str:
    try:
        result = subprocess.run(
            [str(resolve_tool("vcs")), "-ID"],
            capture_output=True, text=True, timeout=30,
        )
    except Exception:
        return "unknown"
    for line in result.stdout.splitlines():
        if "Compiler version" in line:
            return line.split("=", 1)[-1].strip()
    lines = result.stdout.strip().splitlines()
    return lines[0] if lines else "unknown"


def write_setup(ctx: BuildContext, target_dir: Path, units: tuple[Unit, ...], default: Unit) -> Path:
    """Write a `synopsys_sim.setup` mapping library names to analysis dirs.

    Args:
        ctx: Build context.
        target_dir: Directory the tool will run from.
        units: Units whose libraries must be visible.
        default: The unit whose library is `DEFAULT` (the one being
            analyzed, or the block being elaborated).
    """
    lines = ["WORK > DEFAULT", f"DEFAULT : {ctx.analysis_dir(default) / 'AN.DB'}"]
    lines.extend(f"{u.name} : {ctx.analysis_dir(u) / 'AN.DB'}" for u in units)
    target_dir.mkdir(parents=True, exist_ok=True)
    path = target_dir / SETUP_FILE
    path.write_text("\n".join(lines) + "\n")
    return path


def analyze_unit(ctx: BuildContext, unit: Unit, upstream: tuple[Unit, ...]) -> list[ToolRun]:
    """Analyze one unit into its library, skipping if current."""
    an_dir = ctx.analysis_dir(unit)
    an_dir.mkdir(parents=True, exist_ok=True)

    stamp = an_dir / STAMP_FILE
    current_hash = ctx.unit_hash(unit)
    if stamp.is_file() and stamp.read_text().strip() == current_hash:
        return []

    write_setup(ctx, an_dir, (*upstream, unit), default=unit)

    ordered = order_sources(list(unit.sources), unit.manifest.sources.order)
    runs: list[ToolRun] = []
    history = history_path(ctx.root)
    meta = {"block": ctx.plan.name, "unit": unit.name, "profile": ctx.profile.name}
    label = f"{ctx.plan.name}/{unit.name}"

    vhdl = [s for s in ordered if s.compiled and s.language is Language.VHDL]
    verilog = [s for s in ordered if s.compiled and s.language is not Language.VHDL]

    if vhdl:
        filelist = write_sources_filelist(
            ordered, ctx.incdirs, ctx.defines, an_dir / "vhdl.f", Language.VHDL, label
        )
        run = run_tool(
            tool="vhdlan", phase="analyze",
            argv=[str(resolve_tool("vhdlan")), "-full64", "-work", unit.name,
                  "-f", str(filelist), "-l", "vhdlan.log"],
            cwd=an_dir, log=an_dir / "vhdlan.log",
            metadata=meta, record_to=history, dry_run=ctx.options.dry_run,
        )
        runs.append(run)
        if not run.ok:
            raise BuildError(f"vhdlan failed for {unit.name}, see {run.log}", run)

    if verilog:
        filelist = write_sources_filelist(
            ordered, ctx.incdirs, ctx.defines, an_dir / "sv.f", Language.SYSTEMVERILOG, label
        )
        run = run_tool(
            tool="vlogan", phase="analyze",
            argv=[str(resolve_tool("vlogan")), "-full64", "-sverilog", "-work", unit.name,
                  "-f", str(filelist), "-l", "vlogan.log"],
            cwd=an_dir, log=an_dir / "vlogan.log",
            metadata=meta, record_to=history, dry_run=ctx.options.dry_run,
        )
        runs.append(run)
        if not run.ok:
            raise BuildError(f"vlogan failed for {unit.name}, see {run.log}", run)

    if not ctx.options.dry_run:
        stamp.write_text(current_hash + "\n")
    return runs


def analyze(ctx: BuildContext) -> list[ToolRun]:
    """Analyze every unit in dependency order. Each is skipped if current."""
    runs: list[ToolRun] = []
    done: list[Unit] = []
    for unit in ctx.plan.units:
        runs.extend(analyze_unit(ctx, unit, tuple(done)))
        done.append(unit)
    return runs


def write_coverage_hierarchy(ctx: BuildContext) -> Path | None:
    """Generate the `-cm_hier` file. Default scope is the DUT subtree."""
    if ctx.profile.coverage_scope == "all":
        return None
    path = ctx.profile_dir / HIER_FILE
    path.write_text(
        f"// generated by ingot — coverage scope, profile {ctx.profile.name}\n"
        f"+tree {ctx.plan.top}.{ctx.plan.unit.manifest.dut}\n"
    )
    return path


def elaborate(ctx: BuildContext) -> tuple[Artifact, ToolRun]:
    """Elaborate the block into its profile directory."""
    if ctx.plan.top is None:
        raise BuildError(
            f"{ctx.plan.name}: no top module. Set `top` under [block].\n"
            f"  If this is a library, it is exercised by unit tests, not `ingot build`."
        )

    ctx.profile_dir.mkdir(parents=True, exist_ok=True)
    write_setup(ctx, ctx.profile_dir, ctx.plan.units, default=ctx.plan.unit)

    argv = [
        str(resolve_tool("vcs")), "-full64",
        f"-Mdir={ctx.profile_dir / 'csrc'}",
        "-o", str(ctx.simv),
        "-l", "elab.log",
    ]
    if ctx.options.incremental:
        argv.append("-Mupdate")
    if ctx.options.jobs > 1:
        argv.append(f"-j{ctx.options.jobs}")
    argv.extend(ctx.profile.elab_args)
    if ctx.profile.coverage:
        argv += ["-cm", ctx.profile.coverage_metrics]
        hierarchy = write_coverage_hierarchy(ctx)
        if hierarchy is not None:
            argv += ["-cm_hier", str(hierarchy)]
    argv.extend(ctx.options.extra_elab_args)
    argv.append(ctx.plan.top)

    run = run_tool(
        tool="vcs", phase="elaborate", argv=argv,
        cwd=ctx.profile_dir, log=ctx.profile_dir / "elab.log",
        metadata={"block": ctx.plan.name, "profile": ctx.profile.name, "top": ctx.plan.top},
        record_to=history_path(ctx.root), dry_run=ctx.options.dry_run,
    )
    if not run.ok:
        raise BuildError(f"vcs elaboration failed, see {run.log}", run)

    artifact = Artifact(
        block=ctx.plan.name, profile=ctx.profile.name,
        path=str(ctx.simv), build_dir=str(ctx.profile_dir),
        manifest_hash=ctx.plan.content_hash(), options_hash=ctx.options_hash(),
        tool_version="dry-run" if ctx.options.dry_run else vcs_version(),
        top=ctx.plan.top,
    )
    if not ctx.options.dry_run:
        artifact.save()
    return artifact, run


def build(ctx: BuildContext) -> tuple[Artifact, list[ToolRun]]:
    """Analyze and elaborate, reusing a current artifact."""
    existing = Artifact.load(ctx.profile_dir)
    if existing is not None and existing.is_current(ctx):
        return existing, []
    runs = analyze(ctx)
    artifact, elab_run = elaborate(ctx)
    return artifact, [*runs, elab_run]
