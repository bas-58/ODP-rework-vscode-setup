"""Remove build output."""

from __future__ import annotations

import shutil
from typing import Annotated

import typer

from ingot.commands._common import fail
from ingot.manifest.resolve import project_root, resolve_block
from ingot.manifest.schema import ManifestError

app = typer.Typer(help="Remove build output.")


@app.callback(invoke_without_command=True)
def clean_command(
    block: Annotated[str | None, typer.Argument(help="Block to clean. Omit for everything.")] = None,
    profile: Annotated[str | None, typer.Option("--profile", "-p", help="Only this profile's elaboration.")] = None,
) -> None:
    """Remove build output. Run history in `.ingot/` is never touched."""
    try:
        root = project_root()
        if block is None:
            target = root / "build"
        else:
            plan = resolve_block(block, root)
            target = root / "build" / plan.name
            if profile:
                target = target / profile
    except ManifestError as error:
        raise fail(str(error)) from error

    if not target.exists():
        typer.echo(f"nothing to clean at {target.relative_to(root)}")
        return
    shutil.rmtree(target)
    typer.echo(f"removed {target.relative_to(root)}")
