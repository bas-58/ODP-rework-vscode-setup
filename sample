html
{% extends "base.html" %}

{% set ingot_section = page.meta.section
   if page and page.meta and page.meta.section
   else (page.url | string) %}

{% set section_labels = {
  'start':        'Tutorial',
  'guides':       'Guide',
  'concepts':     'Concept',
  'reference':    'Reference',
  'background':   'Background',
  'contributing': 'Contributing',
  'decisions':    'Decision record',
  'about':        'About'
} %}

{% set section_key = (ingot_section | string).split('/')[0] %}

{% block content %}
<div class="ingot-page" data-section="{{ ingot_section }}">

  {% if section_labels.get(section_key) %}
  <div class="ingot-meta">
    <span class="ingot-meta__section">{{ section_labels[section_key] }}</span>

    {% if page.meta and page.meta.time %}
    <span class="ingot-meta__item">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
      {{ page.meta.time }}
    </span>
    {% endif %}

    {% if page.meta and page.meta.needs %}
    <span class="ingot-meta__item">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
      {{ page.meta.needs }}
    </span>
    {% endif %}

    {% if page.meta and page.meta.status %}
    <span class="ingot-meta__status" data-status="{{ page.meta.status }}">{{ page.meta.status }}</span>
    {% endif %}
  </div>
  {% endif %}

{{ super() }}
</div>
{% endblock %}

{% block footer %}
<footer class="ingot-docs-footer">
  <div class="md-grid ingot-docs-footer__inner">
    <a class="ingot-lockup ingot-lockup--small" href="{{ config.site_url or '/' }}">
      <img src="{{ 'assets/logo.svg' | url }}" alt="">
      <span>Ingot</span>
    </a>
    <nav class="ingot-docs-footer__links" aria-label="Footer">
      <a href="{{ 'start/first-block/' | url }}">Getting started</a>
      <a href="{{ 'concepts/units-and-libraries/' | url }}">Concepts</a>
      <a href="{{ 'reference/cli/' | url }}">Reference</a>
      <a href="{{ 'contributing/' | url }}">Contributing</a>
      <a href="{{ 'about/' | url }}">About</a>
    </nav>
    <p class="ingot-docs-footer__meta">Silicon development platform for circuitware.</p>
  </div>
</footer>
