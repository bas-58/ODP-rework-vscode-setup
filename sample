}

.md-sidebar__scrollwrap {
  scrollbar-width: thin;
}

/* ---- Content typography ---------------------------------------------- */

.md-typeset {
  font-size: 0.82rem;
  line-height: 1.7;
}

.md-typeset > h1:first-of-type::before {
  content: var(--ingot-section-label, none);
  display: block;
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--ingot-section, var(--md-default-fg-color--lighter));
  margin-bottom: 0.75rem;
}

.md-typeset h1 {
  font-weight: 500;
  letter-spacing: -0.022em;
  line-height: 1.15;
  margin-bottom: 1.25rem;
  color: var(--md-default-fg-color);
}

.md-typeset h2 {
  font-weight: 500;
  letter-spacing: -0.015em;
  margin-top: 2.6em;
  padding-bottom: 0.4em;
  border-bottom: 1px solid var(--ingot-line);
}

.md-typeset h3 {
  font-weight: 600;
  margin-top: 2em;
}

.md-typeset h4 {
  font-weight: 600;
  font-size: 0.85rem;
  letter-spacing: 0.02em;
}

.md-typeset a {
  text-decoration: none;
  border-bottom: 1px solid rgba(200, 208, 216, 0.3);
  transition: border-color 0.15s, color 0.15s;
}

.md-typeset a:hover {
  border-bottom-color: currentColor;
}

.md-typeset a code {
  border-bottom: none;
}

.md-typeset strong {
  font-weight: 600;
  color: var(--md-default-fg-color);
}

.md-typeset hr {
  border-bottom: 1px solid var(--ingot-line);
  margin: 3em 0;
}

.md-typeset blockquote {
  border-left: 2px solid var(--ingot-section, var(--ingot-accent));
  color: var(--md-default-fg-color--light);
  font-style: normal;
}

.md-typeset kbd {
  font-family: var(--ingot-mono);
  font-size: 0.7em;
  border-radius: 0.25rem;
  box-shadow: 0 1px 0 var(--ingot-line), 0 0 0 1px var(--ingot-line);
  background: var(--ingot-surface);
}

/* ---- Code ------------------------------------------------------------- */

.md-typeset code,
.md-typeset pre > code {
  font-family: var(--ingot-mono);
  font-variant-ligatures: none;
}

.md-typeset code {
  font-size: 0.82em;
  padding: 0.12em 0.4em;
  border-radius: 0.3rem;
  border: 1px solid var(--ingot-line);
  background: var(--ingot-surface);
}

.md-typeset pre {
  margin: 1.4em 0;
}

.md-typeset pre > code {
  font-size: 0.76rem;
  line-height: 1.65;
  padding: 1rem 1.2rem;
  border-radius: 0.5rem;
  border: 1px solid var(--ingot-line);
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
}

.md-typeset .highlight .filename {
  font-family: var(--ingot-mono);
  font-size: 0.68rem;
  letter-spacing: 0.04em;
  border-radius: 0.5rem 0.5rem 0 0;
  border: 1px solid var(--ingot-line);
  border-bottom: none;
  background: var(--ingot-surface);
}

.md-typeset .highlight .filename + pre > code {
  border-radius: 0 0 0.5rem 0.5rem;
}

.md-clipboard {
  color: var(--md-default-fg-color--lighter);
}

.md-clipboard:hover {
  color: var(--ingot-section, var(--md-default-fg-color));
}

.md-typeset .md-annotation__index {
  background: var(--ingot-section, var(--ingot-accent));
}

/* ---- Admonitions ------------------------------------------------------ */

.md-typeset .admonition,
.md-typeset details {
  border: 1px solid var(--ingot-line);
  border-left-width: 1px;
  border-radius: 0.5rem;
  background: var(--ingot-surface);
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
  font-size: 0.8rem;
}

.md-typeset .admonition-title,
.md-typeset summary {
  background: var(--ingot-accent-soft);
  border-bottom: 1px solid var(--ingot-line);
  border-radius: 0.5rem 0.5rem 0 0;
  font-weight: 600;
  padding-top: 0.55rem;
  padding-bottom: 0.55rem;
}

.md-typeset .admonition.note,
.md-typeset .admonition.tip,
.md-typeset .admonition.warning,
.md-typeset .admonition.success,
.md-typeset .admonition.info,
.md-typeset .admonition.abstract {
  border-color: var(--ingot-line);
}

.md-typeset .tip > .admonition-title,
.md-typeset .success > .admonition-title {
  color: #6FCF97;
}

.md-typeset .warning > .admonition-title,
.md-typeset .caution > .admonition-title {
  color: #D8B270;
}

.md-typeset .danger > .admonition-title,
.md-typeset .failure > .admonition-title,
.md-typeset .bug > .admonition-title {
  color: #F07178;
}

/* ---- Tables ----------------------------------------------------------- */

.md-typeset table:not([class]) {
  font-size: 0.78rem;
  border: 1px solid var(--ingot-line);
  border-radius: 0.5rem;
  overflow: hidden;
  display: table;
  width: 100%;
}

.md-typeset table:not([class]) th {
  background: var(--ingot-accent-soft);
  font-weight: 600;
  font-size: 0.72rem;
  letter-spacing: 0.06em;
