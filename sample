/* =========================================================================
   Ingot — site theme
   ========================================================================= */

/* ---- Tokens ----------------------------------------------------------- */

:root {
  --ingot-accent:          #55606B;
  --ingot-accent-soft:     rgba(85, 96, 107, 0.12);
  --ingot-line:            rgba(46, 51, 56, 0.14);
  --ingot-surface:         rgba(46, 51, 56, 0.035);
  --ingot-mono:            ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  --ingot-ease:            cubic-bezier(0.22, 1, 0.36, 1);

  --md-primary-fg-color:        #2E3338;
  --md-primary-fg-color--light: #4A5158;
  --md-primary-fg-color--dark:  #16181B;
  --md-primary-bg-color:        #F2F4F6;
  --md-accent-fg-color:         #55606B;
}

[data-md-color-scheme="slate"] {
  --md-hue: 218;

  --ingot-accent:          #C8D0D8;
  --ingot-accent-soft:     rgba(200, 208, 216, 0.08);
  --ingot-line:            rgba(200, 208, 216, 0.11);
  --ingot-surface:         rgba(255, 255, 255, 0.025);

  --md-default-bg-color:        #0F1114;
  --md-default-fg-color:        #E6EAEE;
  --md-default-fg-color--light: #B8C0C8;
  --md-default-fg-color--lighter: #8C96A0;
  --md-default-fg-color--lightest: rgba(200, 208, 216, 0.12);
  --md-code-bg-color:           #0A0C0E;
  --md-code-fg-color:           #DDE3E9;
  --md-primary-fg-color:        #0F1114;
  --md-primary-fg-color--light: #2E3338;
  --md-primary-fg-color--dark:  #0A0C0E;
  --md-primary-bg-color:        #E6EAEE;
  --md-accent-fg-color:         #C8D0D8;
  --md-typeset-a-color:         #C8D0D8;
  --md-footer-bg-color:         #0F1114;
  --md-footer-bg-color--dark:   #0A0C0E;
  --md-footer-fg-color:         #B8C0C8;
}

/* Section accents */
[data-ingot-section="start"]        { --ingot-section: #6FCF97; --ingot-section-label: "Tutorial"; }
[data-ingot-section="guides"]       { --ingot-section: #C8D0D8; --ingot-section-label: "Guide"; }
[data-ingot-section="concepts"]     { --ingot-section: #8FB4D8; --ingot-section-label: "Concept"; }
[data-ingot-section="reference"]    { --ingot-section: #9AA5B1; --ingot-section-label: "Reference"; }
[data-ingot-section="background"]   { --ingot-section: #D8B270; --ingot-section-label: "Background"; }
[data-ingot-section="contributing"] { --ingot-section: #C8D0D8; --ingot-section-label: "Contributing"; }
[data-ingot-section="decisions"]    { --ingot-section: #9AA5B1; --ingot-section-label: "Decision record"; }
[data-ingot-section="about"]        { --ingot-section: #C8D0D8; --ingot-section-label: "About"; }

body {
  -webkit-font-smoothing: antialiased;
}

/* ---- Grid ------------------------------------------------------------- */

.md-grid {
  max-width: 76rem;
}

[data-ingot-section="reference"] .md-grid {
  max-width: 82rem;
}

/* ---- Header ----------------------------------------------------------- */

.md-header {
  background: rgba(15, 17, 20, 0.82);
  backdrop-filter: blur(14px) saturate(140%);
  -webkit-backdrop-filter: blur(14px) saturate(140%);
  box-shadow: none;
  border-bottom: 1px solid var(--ingot-line);
  transition: border-color 0.3s;
}

[data-md-color-scheme="default"] .md-header {
  background: rgba(242, 244, 246, 0.85);
}

.md-header__title {
  font-size: 0.85rem;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.md-header__topic:first-child {
  font-weight: 600;
}

.md-header__button.md-logo img {
  height: 1.6rem;
  width: auto;
}

.md-search__form {
  border-radius: 0.4rem;
  background: var(--ingot-surface);
  border: 1px solid var(--ingot-line);
  box-shadow: none;
}

.md-search__form:hover {
  background: var(--ingot-accent-soft);
}

/* ---- Tabs ------------------------------------------------------------- */

.md-tabs {
  background: transparent;
  border-bottom: 1px solid var(--ingot-line);
}

.md-tabs__link {
  font-size: 0.78rem;
  font-weight: 500;
  letter-spacing: 0.02em;
  opacity: 0.65;
  transition: opacity 0.2s;
  margin-top: 0.6rem;
}

.md-tabs__link--active,
.md-tabs__link:hover {
  opacity: 1;
}

.md-tabs__item--active .md-tabs__link {
  position: relative;
}

.md-tabs__item--active .md-tabs__link::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -0.55rem;
