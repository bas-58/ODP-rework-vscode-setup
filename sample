"""Run a block's testlist."""

from __future__ import annotations

import json
from concurrent.futures import ThreadPoolExecutor, as_completed
from typing import Annotated

import typer

from ingot.commands._common import FLOW_ERRORS, context, fail, repro_hint
from ingot.manifest.schema import ManifestError
from ingot.vcs.build import BuildOptions, build
from ingot.vcs.sim import SimResult, simulate

app = typer.Typer(help="Run a block's regression.")


@app.callback(invoke_without_command=True)
def regress_command(
    block: Annotated[str, typer.Argument()],
    profile: Annotated[str, typer.Option("--profile", "-p")] = "fast",
    jobs: Annotated[int, typer.Option("--jobs", "-j")] = 4,
    seeds: Annotated[int | None, typer.Option("--seeds", help="Override seed count for every test.")] = None,
    as_json: Annotated[bool, typer.Option("--json")] = False,
) -> None:
    """Elaborate once, then run every test in the block's testlist."""
    try:
        plan, _, ctx = context(block, profile, BuildOptions())
        tests = plan.unit.manifest.tests
        if not tests:
            raise ManifestError(f"{block}: no tests. Add a [tests.<name>] section.")
        artifact, _ = build(ctx)
    except FLOW_ERRORS as error:
        raise fail(str(error)) from error

    work = [(name, cfg) for name, cfg in tests.items()
            for _ in range(seeds if seeds is not None else cfg.seeds)]

    results: list[SimResult] = []
    with ThreadPoolExecutor(max_workers=jobs) as pool:
        futures = [pool.submit(simulate, artifact, plan.root, name, None, tuple(cfg.plusargs))
                   for name, cfg in work]
        for future in as_completed(futures):
            result = future.result()
            results.append(result)
            if not as_json:
                mark, colour = ("PASS", typer.colors.GREEN) if result.passed else ("FAIL", typer.colors.RED)
                typer.secho(f"  {mark}  {result.test:<24} seed={result.seed:<11} {result.run.duration_s:6.1f}s", fg=colour)

    failures = [r for r in results if not r.passed]
    if as_json:
        typer.echo(json.dumps({
            "block": block, "profile": profile,
            "total": len(results), "passed": len(results) - len(failures),
            "failed": [{"test": r.test, "seed": r.seed, "reason": r.reason, "log": str(r.log)} for r in failures],
        }, indent=2))
    else:
        typer.echo(f"\n{len(results) - len(failures)}/{len(results)} passed  [{profile}]")
        for r in failures:
            typer.echo(f"\n  {r.test} seed={r.seed}: {r.reason}")
            typer.echo(repro_hint(block, r.test, r.seed))
    if failures:
        raise typer.Exit(1)
