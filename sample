/* ---- Page metadata bar ------------------------------------------------ */

.ingot-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.5rem;
  padding-bottom: 0.9rem;
  border-bottom: 1px solid var(--ingot-line);
  font-size: 0.7rem;
}

.ingot-meta__section {
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--ingot-section, var(--md-default-fg-color--lighter));
}

.ingot-meta__item {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  color: var(--md-default-fg-color--lighter);
}

.ingot-meta__item svg {
  width: 0.85rem;
  height: 0.85rem;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.6;
  stroke-linecap: round;
  stroke-linejoin: round;
  opacity: 0.7;
}

.ingot-meta__status {
  margin-left: auto;
  padding: 0.2rem 0.55rem;
  border-radius: 999px;
  border: 1px solid var(--ingot-line);
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--md-default-fg-color--lighter);
}

.ingot-meta__status[data-status="draft"] {
  color: #D8B270;
  border-color: rgba(216, 178, 112, 0.4);
}

.ingot-meta__status[data-status="stub"] {
  color: #F07178;
  border-color: rgba(240, 113, 120, 0.4);
}

/* ---- Concepts: hairline margin rule and a lede ----------------------- */

[data-ingot-section^="concepts"] .md-content__inner {
  position: relative;
  padding-left: 1.75rem;
}

[data-ingot-section^="concepts"] .md-content__inner::before {
  content: "";
  position: absolute;
  left: 0;
  top: 5.5rem;
  bottom: 4rem;
  width: 1px;
  background: linear-gradient(180deg,
              var(--ingot-section), rgba(143, 180, 216, 0.06));
  opacity: 0.55;
}

[data-ingot-section^="concepts"] .md-typeset > p:first-of-type {
  font-size: 1.08rem;
  line-height: 1.7;
  color: var(--md-default-fg-color--light);
  padding-bottom: 1.25rem;
  border-bottom: 1px solid var(--ingot-line);
  margin-bottom: 2rem;
}

/* ---- Background: dashed edge, aside feel ----------------------------- */

[data-ingot-section^="background"] .md-content__inner {
  position: relative;
  padding-left: 1.75rem;
}

[data-ingot-section^="background"] .md-content__inner::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 3rem;
  width: 3px;
  background: repeating-linear-gradient(
    180deg,
    var(--ingot-section) 0 6px,
    transparent 6px 12px
  );
  opacity: 0.4;
}

@media (max-width: 60rem) {
  [data-ingot-section^="concepts"] .md-content__inner,
  [data-ingot-section^="background"] .md-content__inner {
    padding-left: 0;
  }
  [data-ingot-section^="concepts"] .md-content__inner::before,
  [data-ingot-section^="background"] .md-content__inner::before {
    display: none;
  }
  .ingot-meta__status { margin-left: 0; }
}
