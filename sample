}

.md-typeset table:not([class]) tr:hover td {
  background: var(--ingot-surface);
}

/* ---- Content tabs ----------------------------------------------------- */

.md-typeset .tabbed-set > input:checked + label {
  color: var(--ingot-section, var(--ingot-accent));
