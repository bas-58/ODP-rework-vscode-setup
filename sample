"""Build a block into a simulation binary."""

from __future__ import annotations

import shutil
from typing import Annotated

import typer

from ingot.commands._common import FLOW_ERRORS, context, fail
from ingot.vcs.build import BuildOptions, build

app = typer.Typer(help="Analyze and elaborate a block.")


@app.callback(invoke_without_command=True)
def build_command(
    block: Annotated[str, typer.Argument(help="Block name.")],
    profile: Annotated[str, typer.Option("--profile", "-p")] = "fast",
    clean: Annotated[bool, typer.Option("--clean", help="Discard the profile's build and rebuild.")] = False,
    jobs: Annotated[int, typer.Option("--jobs", "-j")] = 1,
    dry_run: Annotated[bool, typer.Option("--dry-run")] = False,
) -> None:
    """Analyze and elaborate a block for a profile.

    Analysis is shared across profiles and blocks; elaboration is per
    profile. A current artifact is reused unless sources, defines, or the
    profile have changed.
    """
    options = BuildOptions(incremental=not clean, jobs=jobs, dry_run=dry_run)
    try:
        _, prof, ctx = context(block, profile, options)
        if clean and not dry_run:
            shutil.rmtree(ctx.profile_dir, ignore_errors=True)
        artifact, runs = build(ctx)
    except FLOW_ERRORS as error:
        raise fail(str(error)) from error

    if dry_run:
        for run in runs:
            typer.echo(" ".join(run.argv))
        return
    if not runs:
        typer.echo(f"{block} [{prof.name}]: artifact current")
        return
    for run in runs:
        typer.echo(f"  {run.summary()}")
    typer.secho(f"{block} [{prof.name}]: {artifact.simv}", fg=typer.colors.GREEN)
