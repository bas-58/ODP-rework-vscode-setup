"""Manifest schema for blocks, libraries, profiles, and tests.

A unit is defined by an `ingot.toml` at its root carrying either a
`[block]` or `[library]` section. The project root has an `ingot.toml`
too, distinguished by `[project]` or `[gitlab]`, and it is where
`[profiles.*]` live.

Libraries have no `top` and no tests: they are exercised by unit tests,
not testbenches. A design that needs a UVM environment to verify is a
block, wherever it lives.
"""

from __future__ import annotations

from enum import StrEnum

from pydantic import BaseModel, ConfigDict, Field


class Language(StrEnum):
    """Source language, determining which analyzer handles a file."""

    SYSTEMVERILOG = "sv"
    VERILOG = "verilog"
    VHDL = "vhdl"

    @classmethod
    def from_suffix(cls, suffix: str) -> Language | None:
        return {
            ".sv": cls.SYSTEMVERILOG,
            ".svh": cls.SYSTEMVERILOG,
            ".v": cls.VERILOG,
            ".vh": cls.VERILOG,
            ".vhd": cls.VHDL,
            ".vhdl": cls.VHDL,
        }.get(suffix.lower())


class ManifestError(Exception):
    """Raised when a manifest is missing, malformed, or inconsistent."""


class Strict(BaseModel):
    """Base model rejecting unknown fields.

    A typo in a manifest key must be an error. Silently ignoring an
    unrecognized field produces configuration that appears to work and
    does not.
    """

    model_config = ConfigDict(extra="forbid")


class SourcesConfig(Strict):
    """Overrides for source discovery."""

    include: list[str] = Field(default_factory=list)
    exclude: list[str] = Field(default_factory=list)
    order: list[str] = Field(default_factory=list)
    incdirs: list[str] = Field(default_factory=list)
    compile: list[str] = Field(default_factory=list)
    library: str = "work"


class BlockConfig(Strict):
    """A design under test. Has a top and may have tests."""

    name: str
    top: str | None = None
    dut: str = "dut"


class LibraryConfig(Strict):
    """A collection of components. Depended on, never run directly."""

    name: str


class TestConfig(Strict):
    """A named test in a block's testlist."""

    seeds: int = 1
    plusargs: list[str] = Field(default_factory=list)


class ProfileConfig(Strict):
    """A named elaboration configuration.

    Profiles control elaboration-time options only. Runtime behaviour —
    seed, test selection, waveform dumping — is controlled by plusargs.
    """

    description: str = ""
    inherits: str | None = None
    elab_args: list[str] = Field(default_factory=list)
    defines: dict[str, str] = Field(default_factory=dict)
    coverage: bool = False
    coverage_metrics: str = "line+cond+fsm+tgl+branch"
    coverage_scope: str = "dut"


class Manifest(Strict):
    """A parsed unit `ingot.toml`."""

    block: BlockConfig | None = None
    library: LibraryConfig | None = None
    dependencies: dict[str, str] = Field(default_factory=dict)
    sources: SourcesConfig = Field(default_factory=SourcesConfig)
    defines: dict[str, str] = Field(default_factory=dict)
    tests: dict[str, TestConfig] = Field(default_factory=dict)
    profiles: dict[str, ProfileConfig] = Field(default_factory=dict)

    @property
    def name(self) -> str:
        if self.block is not None:
            return self.block.name
        if self.library is not None:
            return self.library.name
        raise ManifestError("manifest declares neither [block] nor [library]")

    @property
    def is_library(self) -> bool:
        return self.library is not None

    @property
    def top(self) -> str | None:
        return self.block.top if self.block else None

    @property
    def dut(self) -> str:
        return self.block.dut if self.block else "dut"

