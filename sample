}

.md-typeset .tabbed-labels {
  border-bottom: 1px solid var(--ingot-line);
}

/* ---- Footer ----------------------------------------------------------- */

.ingot-docs-footer {
  border-top: 1px solid var(--ingot-line);
  padding: 2.5rem 0 2rem;
